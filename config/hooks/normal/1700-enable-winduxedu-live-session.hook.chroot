#!/bin/sh
set -eu

# The disposable Live user is created only at boot by
# winduxedu-live-session-init.service. Do not bake it into /etc/passwd and do not
# give it a password: the native ElevenDE display service starts it directly.
install -d -m 0755 /etc/winduxedu
printf '%s\n' user > /etc/winduxedu/session-user

# ElevenDE owns the only graphical session path. The enablement symlinks are
# created explicitly because live-build does not always preserve preset state
# and 'systemctl enable' cannot run reliably inside the build chroot: a
# flattened regular file left at a .wants path (Windows checkout artifact)
# silently defeats it, which boots to a text login instead of the desktop.
# LightDM must not be present or reintroduced as a competing greeter.
if command -v systemctl >/dev/null 2>&1; then
    systemctl disable lightdm.service >/dev/null 2>&1 || true
fi
install -d -m 0755 /etc/systemd/system/graphical.target.wants \
    /etc/systemd/system/multi-user.target.wants
rm -f /etc/systemd/system/graphical.target.wants/winduxedu-elevende-display.service \
      /etc/systemd/system/multi-user.target.wants/winduxedu-live-session-init.service
ln -sfn ../winduxedu-elevende-display.service \
    /etc/systemd/system/graphical.target.wants/winduxedu-elevende-display.service
ln -sfn ../winduxedu-live-session-init.service \
    /etc/systemd/system/multi-user.target.wants/winduxedu-live-session-init.service

# live-build can install the generic live-config systemd backend independently
# of the explicit package list. Its oneshot service runs Before=basic.target,
# yet WinduxEdu initializes its Live user and graphical session through the two
# native services above. Mask it in the finished Live root so it cannot block
# the graphical target during DHCP, locale or generic profile processing.
install -d -m 0755 /etc/systemd/system
ln -sfn /dev/null /etc/systemd/system/live-config.service
if [ -e /etc/init.d/lightdm ] || [ -e /usr/sbin/lightdm ]; then
    echo 'WinduxEdu: LightDM is not permitted; use winduxedu-elevende-display.service' >&2
    exit 1
fi
