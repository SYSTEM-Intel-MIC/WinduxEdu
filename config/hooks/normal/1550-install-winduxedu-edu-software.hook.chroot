#!/bin/sh
set -eu

EDU_DIR=/opt/winduxedu/edu-packages
if [ ! -d "$EDU_DIR" ] || ! ls "$EDU_DIR"/*.deb >/dev/null 2>&1; then
    echo "WinduxEdu edu-software packages are missing: $EDU_DIR" >&2
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive
# Add i386 architecture for Wine WoW64 support
dpkg --add-architecture i386
apt-get update

# live-build compresses the rootfs squashfs during lb_binary_rootfs and only
# re-enters the chroot afterwards to run its binary-stage `apt-get upgrade`
# / `dist-upgrade` (chroot_archives binary install). Whenever bookworm-security
# carries a newer linux-image than the chroot picked up from bookworm, that
# late upgrade drops a second kernel into /boot. lb_binary_linux-image then
# copies both into binary/live and live-build's syslinux step aborts on its
# multi-source `mv binary/live/vmlinuz-* binary/live/vmlinuz` with:
#   mv: target 'binary/live/vmlinuz': No such file or directory
# The squashfs has already been written with the older kernel at that point, so
# shipping the newer one would leave the image without matching modules anyway.
# Hold the kernel metapackages for the remainder of the build so both stages
# agree on exactly one kernel.
apt-mark hold linux-image-amd64 linux-headers-amd64

# Install Wine 11 stack and all i386 dependencies (moved from package list)
# Core Wine packages
apt-get install -y --no-install-recommends \
    wine wine32 wine64 libwine libwine:i386 fonts-wine

# 钉钉 bundles a PulseAudio client that links against libpulse-mainloop-glib
# explicitly; libpulse0 alone does not pull that split library in, so DingTalk
# died at load time with "libpulse-mainloop-glib.so.0: cannot open shared
# object file".  Ship both architectures: the amd64 build for DingTalk itself,
# the i386 build for the Wine-hosted callers of the same soname.
apt-get install -y --no-install-recommends \
    libpulse-mainloop-glib0 libpulse-mainloop-glib0:i386

# Wine 32-bit library dependencies (i386 architecture)
# Note: libldap in Bookworm is libldap-2.5-0, not libldap-2.4-2
apt-get install -y --no-install-recommends \
    libasound2:i386 \
    libasound2-plugins:i386 \
    libgstreamer-plugins-base1.0-0:i386 \
    libgstreamer1.0-0:i386 \
    libpulse0:i386 \
    libglib2.0-0:i386 \
    libgdk-pixbuf-2.0-0:i386 \
    libgtk-3-0:i386 \
    libatk1.0-0:i386 \
    libatk-bridge2.0-0:i386 \
    libepoxy0:i386 \
    libcairo2:i386 \
    libpango-1.0-0:i386 \
    libharfbuzz0b:i386 \
    libfontconfig1:i386 \
    libfreetype6:i386 \
    libpixman-1-0:i386 \
    libx11-6:i386 \
    libxext6:i386 \
    libxrender1:i386 \
    libxfixes3:i386 \
    libxi6:i386 \
    libxrandr2:i386 \
    libxinerama1:i386 \
    libxcursor1:i386 \
    libxcomposite1:i386 \
    libxdamage1:i386 \
    libxcb1:i386 \
    libx11-xcb1:i386 \
    libxshmfence1:i386 \
    libxxf86vm1:i386 \
    libdrm2:i386 \
    libgl1:i386 \
    libglx0:i386 \
    libglvnd0:i386 \
    libegl1:i386 \
    libgbm1:i386 \
    libwayland-client0:i386 \
    libwayland-cursor0:i386 \
    libwayland-egl1:i386 \
    libwayland-server0:i386 \
    libvulkan1:i386 \
    libvkd3d1:i386 \
    libvkd3d-shader1:i386 \
    libfaudio0:i386 \
    libmpg123-0:i386 \
    libgstreamer-plugins-base1.0-0:i386 \
    libgstreamer1.0-0:i386 \
    libpulse0:i386 \
    libasound2:i386 \
    libasound2-plugins:i386 \
    libgphoto2-6:i386 \
    libgphoto2-port12:i386 \
    libsane:i386 \
    libusb-1.0-0:i386 \
    libudev1:i386 \
    libcap2:i386 \
    libfdt1:i386 \
    libpciaccess0:i386 \
    libdrm-amdgpu1:i386 \
    libdrm-radeon1:i386 \
    libdrm-nouveau2:i386 \
    libelf1:i386 \
    libexpat1:i386 \
    libxml2:i386 \
    liblzma5:i386 \
    libzstd1:i386 \
    libgcrypt20:i386 \
    libgpg-error0:i386 \
    libsystemd0:i386 \
    libdbus-1-3:i386 \
    libapparmor1:i386 \
    libselinux1:i386 \
    libpcre3:i386 \
    libbsd0:i386 \
    libmd0:i386 \
    libffi8:i386 \
    libgmp10:i386 \
    libhogweed6:i386 \
    libnettle8:i386 \
    libtasn1-6:i386 \
    libidn2-0:i386 \
    libunistring2:i386 \
    libpsl5:i386 \
    libnghttp2-14:i386 \
    libcurl4:i386 \
    libssh2-1:i386 \
    librtmp1:i386 \
    libssh-4:i386 \
    libgssapi-krb5-2:i386 \
    libkrb5-3:i386 \
    libk5crypto3:i386 \
    libcom-err2:i386 \
    libkrb5support0:i386 \
    libkeyutils1:i386 \
    libsasl2-2:i386 \
    libgnutls30:i386 \
    libp11-kit0:i386 \
    libtasn1-6:i386 \
    libnettle8:i386 \
    libhogweed6:i386 \
    libgcrypt20:i386 \
    libgpg-error0:i386

# Create dpkg pre-inst hook to force HOME=/root for all postinsts
mkdir -p /etc/dpkg/pre-inst.d
cat > /etc/dpkg/pre-inst.d/set-home <<'EOF'
#!/bin/sh
export HOME=/root
EOF
chmod +x /etc/dpkg/pre-inst.d/set-home

installed=0
for deb in "$EDU_DIR"/*.deb; do
    package_name="$(dpkg-deb -f "$deb" Package)"

    if [ "$package_name" = "com.seewo.terminalmanager" ]; then
        # 希沃管家 declares "Depends: libstdc++6 (>= 8.3), libstdc++6 (<< 9),
        # dkms".  The upper bound is vendor over-caution: scanning every ELF in
        # the package shows the highest requirement is GLIBCXX_3.4.22 /
        # CXXABI_1.3.11 (GCC 5 era), which Bookworm's libstdc++6 12.x still
        # satisfies backwards.  apt can never resolve `<< 9` here and would
        # abort the whole transaction, so drop the bogus clause and rebuild the
        # DEB before handing it to apt.  Rewriting the control file keeps the
        # dpkg database consistent for the later apt runs in this build;
        # --force-depends would leave it permanently broken instead.
        repack_dir="$(mktemp -d)"
        dpkg-deb -R "$deb" "$repack_dir"
        sed -i 's/^Depends: .*/Depends: libstdc++6 (>= 8.3), dkms/' "$repack_dir/DEBIAN/control"
        grep -qx 'Depends: libstdc++6 (>= 8.3), dkms' "$repack_dir/DEBIAN/control" || {
            echo "failed to rewrite the Seewo Terminal Manager dependency list" >&2
            rm -rf "$repack_dir"
            exit 1
        }
        dpkg-deb -b -Zgzip -z1 "$repack_dir" "$deb"
        rm -rf "$repack_dir"
    fi

    # Also disable DKMS builds for vendor packages (e.g. hugo_firewall) since
    # the CI runner's Azure kernel (6.17.0-1022-azure) headers are not available
    # in the Debian chroot. The DKMS modules are not needed in the Live image.
    # The hugo_firewall package attempts DKMS builds which fail; we repack it
    # to drop the DKMS dependency and postinst script entirely.
    if [ "$package_name" = "hugo_firewall" ]; then
        repack_dir="$(mktemp -d)"
        dpkg-deb -R "$deb" "$repack_dir"
        # Drop DKMS from Depends and clear the postinst to avoid DKMS builds
        sed -i 's/^Depends: .*/Depends:/' "$repack_dir/DEBIAN/control"
        > "$repack_dir/DEBIAN/postinst"
        chmod +x "$repack_dir/DEBIAN/postinst"
        dpkg-deb -b -Zgzip -z1 "$repack_dir" "$deb"
        rm -rf "$repack_dir"
    fi

    # Ensure HOME is set for vendor postinsts that write to $HOME/.config/mimeapps.list
    # (ONLYOFFICE, 希沃白板). Some postinsts run in contexts that don't inherit
    # environment variables, so set it in /etc/environment, ensure the directory exists,
    # and force HOME for the apt-get install subprocess.
    echo 'HOME="/root"' >> /etc/environment
    mkdir -p /home/root/.config
    # The 希沃白板 mime helper hard-codes /home/$USER/.config and computes the
    # user as ${HOME#/home/}; with HOME=/root that resolves to /home//.config
    # and the script logs "write_.config_mimeapp_config failed".  The parent is
    # root-owned, so create it here instead of letting every vendor postinst
    # print the same failure.
    mkdir -p /home/.config
    HOME=/root apt-get install -y --no-install-recommends "$deb"
    installed=$((installed + 1))
done

# Vendor packages switch themselves on at boot.  Most of these do not belong in
# the boot path of a generic Live image, and each is an unknown variable for
# the QEMU smoke test, so mask them through /etc/systemd/system: the dpkg-owned
# unit files stay untouched while every activation path is refused.
mask_unit() {
    # Drop every activation link first: enable puts them at
    # /etc/systemd/system/<target>.wants/<unit>, a direct child, so a
    # */wants glob would never match it.
    find /etc/systemd/system -mindepth 2 -type l -name "$1" -delete 2>/dev/null || true
    ln -sfn /dev/null "/etc/systemd/system/$1"
}
# 希沃管家 is two programs and only one of them is an autostart decision:
#   * com.seewo.terminalmanager.service runs
#     /opt/apps/com.seewo.terminalmanager/files/hugo_launcher/hugo_launcher
#     --runmode=daemon, the backend the SeewoServiceAssistant window talks to.
#     Masking it (the old behaviour) left the window opening from All Apps
#     while nothing was listening, which is exactly the reported
#     "Cannot read property 'data' of undefined".  The vendor postinst enables
#     and starts this unit itself, so keep it enabled in the image too: the
#     Live session has no installer step that could enable it later.
#   * /etc/xdg/autostart/com.seewo.terminalmanager.desktop merely re-opens that
#     window at login, and is still removed below until 教育版设置 →
#     希沃管家开机自启 restores it.
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sfn /usr/lib/systemd/system/com.seewo.terminalmanager.service \
    /etc/systemd/system/multi-user.target.wants/com.seewo.terminalmanager.service
mask_unit com.cvte.maxhub.alfred.service
mask_unit disable-seewo-network-card.service

# 希沃侧边栏 (EasiSideBar) and its UDI hotspot dependency are third-party
# internet software, unrelated to WinduxEdu/SYSTEM-Intel-MIC (see
# THIRD-PARTY-NOTICES.md), and both ship **enabled by default**: the sidebar
# registers a *user* systemd unit, UDI a system one whose postinst runs
# `systemctl enable`.  教育版设置 → 侧边栏 switches the two together through
# winduxedu-edu-apply, so the image must start from the OFF state.
if [ ! -f /usr/lib/systemd/user/com.seewo.easisidebar.service ]; then
    echo "the sidebar user unit was not installed" >&2
    exit 1
fi
mkdir -p /etc/systemd/user
# Global mask: refused for every account until the setting is switched on.
find /etc/systemd/user -mindepth 2 -type l -name 'com.seewo.easisidebar.service' -delete 2>/dev/null || true
ln -sfn /dev/null /etc/systemd/user/com.seewo.easisidebar.service
mask_unit com.ifpdos.udi.hotspot.service

# EasiSideBar aborts on the first frame when "Noto Sans CJK SC" is missing:
# its Avalonia host hard-codes that family, the deb declares no Depends, and
# StandardOutput=null throws the stack trace away, so the unit crash-loops
# silently.  The font is a hard build requirement, not a nice-to-have.
dpkg-query -W -f='${Status}' fonts-noto-cjk 2>/dev/null |
    grep -q '^install ok installed$' || {
    echo "fonts-noto-cjk is missing; EasiSideBar would crash-loop" >&2
    exit 1
}

# Save the vendor autostart entry before dropping it.  教育版设置 → 希沃管家
# restores through winduxedu-edu-apply, whose fallback chain starts at
# /usr/share/winduxedu/vendor-autostart; the plain `rm -f` below used to leave
# that copy permanently missing, so switching 希沃管家开机自启 back on could
# only ever report "no entry to restore" (the restore is marked required).
mkdir -p /usr/share/winduxedu/vendor-autostart
for vendor_autostart_entry in \
    /etc/xdg/autostart/com.seewo.terminalmanager.desktop \
    /etc/xdg/autostart/*[sS]idebar*.desktop; do
    [ -s "$vendor_autostart_entry" ] || continue
    install -m 0644 "$vendor_autostart_entry" \
        "/usr/share/winduxedu/vendor-autostart/$(basename "$vendor_autostart_entry")"
    rm -f "$vendor_autostart_entry"
done
if [ -d /home ]; then
    find /home -name 'com.seewo.terminalmanager.desktop' -delete 2>/dev/null || true
fi

# Vendor packages that only ship menu entries under /opt/apps/... would stay
# invisible to the desktop menu; export every application entry that lacks a
# usable /usr/share/applications counterpart.  希沃管家 ships a zero-byte
# placeholder there (its postinst materialises the real file under /opt), so a
# plain existence test would leave an empty menu entry behind.
for desktop in /opt/apps/*/entries/applications/*.desktop; do
    [ -f "$desktop" ] || continue
    [ -s "$desktop" ] || continue
    target="/usr/share/applications/$(basename "$desktop")"
    if [ ! -s "$target" ]; then
        install -m 0644 "$desktop" "$target"
    fi
done

# 教育版设置 restores the 希沃管家 autostart entry from
# /usr/share/winduxedu/vendor-autostart first.  The vendor deb ships a
# zero-byte placeholder under /usr/share/applications (see above) and may not
# install an /etc/xdg/autostart record at all, so seed that copy from the menu
# entry the loop above has just materialised: the restore path is marked
# required, and without a seed switching 希沃管家开机自启 back on could only
# ever report "no entry to restore".
if [ ! -s /usr/share/winduxedu/vendor-autostart/com.seewo.terminalmanager.desktop ] &&
    [ -s /usr/share/applications/com.seewo.terminalmanager.desktop ]; then
    install -m 0644 /usr/share/applications/com.seewo.terminalmanager.desktop \
        /usr/share/winduxedu/vendor-autostart/com.seewo.terminalmanager.desktop
fi

# Taskbar icons for the same vendor apps: ElevenDE matches a window against
# StartupWMClass= (case-insensitively) or the desktop file's own id, and only
# then falls back to a transient _NET_WM_ICON.  Electron-based vendor GUIs such
# as SeewoServiceAssistant publish their *binary* name as WM_CLASS, never the
# reverse-DNS desktop id, and ship no StartupWMClass= at all, so their task
# buttons had no stable icon source and showed up blank or generic.  Derive
# the value from the entry's own Exec line; entries that already declare one
# are left untouched.
add_wmclass_from_exec() {
    entry="$1"
    grep -q '^StartupWMClass=' "$entry" && return 0
    exec_line="$(sed -n 's/^Exec=//p' "$entry" | head -n1)"
    [ -n "$exec_line" ] || return 0
    wm_class=""
    for token in $exec_line; do
        token="$(printf '%s' "$token" | tr -d '"')"
        case "$token" in
            /*) candidate="$(basename "$token")" ;;
            -*) continue ;;
            *) candidate="$token" ;;
        esac
        case "$candidate" in
            sh | bash | dash | env | sudo | nohup | script | env.*) continue ;;
        esac
        wm_class="$candidate"
        break
    done
    [ -n "$wm_class" ] || return 0
    printf 'StartupWMClass=%s\n' "$wm_class" >>"$entry"
}
for desktop in /opt/apps/*/entries/applications/*.desktop; do
    [ -s "$desktop" ] || continue
    target="/usr/share/applications/$(basename "$desktop")"
    [ -s "$target" ] || continue
    add_wmclass_from_exec "$target"
done

if [ ! -s /usr/share/applications/com.seewo.terminalmanager.desktop ]; then
    echo "Seewo Terminal Manager menu entry is missing or empty" >&2
    exit 1
fi
for masked in com.cvte.maxhub.alfred.service \
              disable-seewo-network-card.service \
              com.ifpdos.udi.hotspot.service; do
    [ -L "/etc/systemd/system/$masked" ] || {
        echo "vendor unit is not masked: $masked" >&2
        exit 1
    }
    [ "$(readlink "/etc/systemd/system/$masked")" = "/dev/null" ] || {
        echo "vendor unit is masked incorrectly: $masked" >&2
        exit 1
    }
done
# ...but 希沃管家's own backend must stay reachable: SeewoServiceAssistant
# reads its configuration from hugo_launcher, so an unstarted daemon is what
# produced the "Cannot read property 'data' of undefined" window.
[ ! -L /etc/systemd/system/com.seewo.terminalmanager.service ] || {
    echo "the Seewo Terminal Manager backend must not be masked" >&2
    exit 1
}
[ -e /etc/systemd/system/multi-user.target.wants/com.seewo.terminalmanager.service ] || {
    echo "the Seewo Terminal Manager backend is not enabled at boot" >&2
    exit 1
}
# The sidebar runs as a *user* unit, so its switch lives in the global
# /etc/systemd/user namespace instead of /etc/systemd/system.
[ -L /etc/systemd/user/com.seewo.easisidebar.service ] || {
    echo "the sidebar user unit is not globally masked" >&2
    exit 1
}
[ "$(readlink /etc/systemd/user/com.seewo.easisidebar.service)" = "/dev/null" ] || {
    echo "the sidebar user unit is masked incorrectly" >&2
    exit 1
}
if [ -e /etc/systemd/user/default.target.wants/com.seewo.easisidebar.service ] ||
   [ -e /etc/systemd/user/graphical-session.target.wants/com.seewo.easisidebar.service ]; then
    echo "the sidebar user unit still has an activation link" >&2
    exit 1
fi

# 桌面批注 is a sidebar miniapp, not an application: its postinst copies
# miniapp.info into /etc/EasiSideBar/MiniApps and the sidebar lists it from
# there.  Without that file the sidebar comes up without 批注.
if [ ! -s /etc/EasiSideBar/MiniApps/com.cvte.seewo.desktop_annotation ]; then
    echo "the sidebar annotation miniapp was not registered" >&2
    exit 1
fi
if [ ! -x /opt/apps/com.seewo.easiminiapps.desktopinkannotation/files/bin/DesktopInkAnnotation ]; then
    echo "the annotation binary is missing" >&2
    exit 1
fi

# 人数统计 and 随机抽选 point their sidebar record at a shell script, and .NET's
# Process.Start is a bare execve with no ENOEXEC fallback: a script without a
# shebang makes the kernel fail the spawn, so the click does nothing at all
# (field report item 11 -- 截屏/计时器/批注 work because they are ELF).  Give
# every script entry point a record references an interpreter line, keep it
# executable, and leave ELF targets untouched.
for miniapp in /etc/EasiSideBar/MiniApps/*; do
    [ -s "$miniapp" ] || continue
    miniapp_exec="$(sed -n 's/^ExecutablePath=//p' "$miniapp" | head -n1)"
    [ -n "$miniapp_exec" ] || continue
    [ -f "$miniapp_exec" ] || continue
    case "$(head -c4 "$miniapp_exec" | od -An -tx1 | tr -d ' \n')" in
        7f454c46*)
            # ELF binary: execve runs it as-is.
            continue
            ;;
        2321*)
            ;;
        *)
            # Only a text file may receive an interpreter line: prepending one
            # to a binary would corrupt an entry point execve could have run
            # as-is.  grep -I reports "binary" (exit 1) as soon as a NUL byte
            # shows up in the first chunk.
            if LC_ALL=C grep -Iq '' "$miniapp_exec"; then
                sed -i '1i #!/bin/sh' "$miniapp_exec"
                echo "added a shebang to sidebar entry point: $miniapp_exec"
            else
                echo "warning: sidebar entry point is binary but not ELF, leaving it untouched: $miniapp_exec" >&2
                chmod 0755 "$miniapp_exec"
                continue
            fi
            ;;
    esac
    chmod 0755 "$miniapp_exec"
    head -c2 "$miniapp_exec" | grep -q '#!' || {
        echo "sidebar entry point still has no shebang: $miniapp_exec" >&2
        exit 1
    }
done
if [ -e /etc/xdg/autostart/com.seewo.terminalmanager.desktop ]; then
    echo "Seewo Terminal Manager autostart entry survived" >&2
    exit 1
fi

# Requested desktop (field report item 7): 希沃白板, 班级优化大师, 视频展台,
# 希沃管家, 微信, QQ, 钉钉, ONLYOFFICE -- on top of 此电脑, 主目录, Edge and
# 终端, which hook 1500 already writes.  The shell reads Name/Icon/Exec from
# the record itself, so copy the vendor entry into the skeleton (both the live
# session and every installed user inherit it) and drop the menu-only flags
# that would hide it there.  A record that cannot be found is reported instead
# of failing the build, and the diagnostic below makes it visible either way.
install -d /etc/skel/Desktop
winduxedu_desktop_shortcut() {
    ds_name="$1"
    ds_key="$2"
    shift 2
    found=""
    for ds_id in "$ds_key" "$@"; do
        [ -z "$found" ] || break
        for ds_dir in /usr/share/applications /usr/local/share/applications; do
            [ -f "$ds_dir/$ds_id.desktop" ] || continue
            found="$ds_dir/$ds_id.desktop"
            break
        done
    done
    if [ -z "$found" ]; then
        for ds_id in "$ds_key" "$@"; do
            [ -z "$found" ] || break
            found="$(find /usr/share/applications /usr/local/share/applications \
                -maxdepth 1 -type f -iname "*${ds_id}*.desktop" 2>/dev/null \
                | sort | head -n1)"
        done
    fi
    if [ -z "$found" ]; then
        echo "warning: no application entry for desktop shortcut ${ds_name} (key ${ds_key})" >&2
        return 0
    fi
    install -m 0644 "$found" "/etc/skel/Desktop/${ds_name}.desktop"
    # Remove menu-only flags that would hide the shortcut on the desktop
    sed -i -e '/^NoDisplay=/d' -e '/^Hidden=/d' \
        -e '/^OnlyShowIn=/d' -e '/^NotShowIn=/d' \
        "/etc/skel/Desktop/${ds_name}.desktop"
    # Fix icon if it's a bare name that doesn't exist in the theme:
    # try to find a vendor-installed icon file and point to it directly.
    icon_field="$(grep '^Icon=' "/etc/skel/Desktop/${ds_name}.desktop" | head -n1 | cut -d= -f2-)"
    if [ -n "$icon_field" ] && [ ! -f "$icon_field" ]; then
        # Not an absolute path; check if it exists in the theme
        if ! gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null | grep -q "^$icon_field"; then
            # Try to find vendor icon in /opt/apps/<id>/ or /usr/share/icons/
            vendor_icon="$(find /opt/apps -name "${icon_field}*.png" -o -name "${icon_field}*.svg" 2>/dev/null | head -n1)"
            if [ -n "$vendor_icon" ]; then
                sed -i "s|^Icon=.*|Icon=$vendor_icon|" "/etc/skel/Desktop/${ds_name}.desktop"
                echo "desktop shortcut: fixed icon for ${ds_name} -> $vendor_icon"
            fi
        fi
    fi
    echo "desktop shortcut: ${ds_name} <- ${found}"
}
winduxedu_desktop_shortcut 希沃白板 com.seewo.easinote5 easinote
winduxedu_desktop_shortcut 班级优化大师 com.seewo.easicare easicare
winduxedu_desktop_shortcut 视频展台 com.seewo.easicamera easicamera
winduxedu_desktop_shortcut 希沃管家 com.seewo.terminalmanager terminalmanager
winduxedu_desktop_shortcut 微信 wechat com.tencent.wechat
winduxedu_desktop_shortcut QQ linuxqq qq com.qq.QQ
winduxedu_desktop_shortcut 钉钉 com.alibabainc.dingtalk dingtalk
winduxedu_desktop_shortcut ONLYOFFICE onlyoffice-desktopeditors onlyoffice
# Report what the shell will actually render so a wrong id is visible in the
# build log rather than as a missing icon on the teacher's desktop.
for shortcut in /etc/skel/Desktop/*.desktop; do
    [ -f "$shortcut" ] || continue
    if ! grep -q '^Exec=' "$shortcut" || ! grep -q '^Name=' "$shortcut"; then
        echo "warning: unusable desktop shortcut (no Name/Exec): $shortcut" >&2
        continue
    fi
    echo "desktop shortcut ok: $(basename "$shortcut") -> $(sed -n 's/^Exec=//p' "$shortcut" | head -n1)"
done

# ---------------------------------------------------------------------------
# Vendor application adaptations.
#
# The collected DEBs are installed unmodified (edu-software/README.md rule 3),
# so everything below operates on the *installed* system only: entry points,
# bundled libraries, autostart registrations and MIME defaults.
# ---------------------------------------------------------------------------

# --- 钉钉 (task: DingTalk never started) ---------------------------------
# Elevator.sh puts the bundled library directory first on LD_LIBRARY_PATH, so
# a stale vendor library wins over the system one.  The vendor's own postinst
# is meant to remove exactly the members that are older than a modern glibc
# (libm.so.6, libgbm*, libstdc++.so.6(.0.25), the GLVND stubs, bundled
# harfbuzz), but that loop is buried behind `for file in $(ls /home)` and it
# demonstrably left libstdc++.so.6 in the image we ship.  Bookworm runs
# glibc 2.36, so all of those removals apply here; without them the system
# libgtk-3.so.0 dragged in by the bundled web view dies with
# "GLIBC_2.3x not found".
DT_FILES=/opt/apps/com.alibabainc.dingtalk/files
if [ ! -d "$DT_FILES" ]; then
    echo "DingTalk release directory is missing" >&2
    exit 1
fi
# files/ holds several directories -- the versioned release next to
# Chromium's locales/crashpad/... siblings -- and readdir order has nothing
# to do with the sorted order a later reader of the image uses.  Picking "the
# first" directory therefore cleans and verifies a different one than the
# verifier inspects, which let the stale members survive into the ISO while
# this hook happily reported success.  Sweep every level, then verify every
# level, and print the layout so the build log carries the ground truth.
echo "DingTalk files layout:"
find "$DT_FILES" -maxdepth 2 -type d -print | sort | head -n 40
find "$DT_FILES" \( \
        -name 'libm.so.6' -o \
        -name 'libstdc++.so.6*' -o \
        -name 'libgbm.so*' -o \
        -name 'libGLX.so*' -o \
        -name 'libGLdispatch.so*' -o \
        -name 'libffi.so.6.0.4' -o \
        -name 'libharfbuzz.so*' \) \
    \( -type f -o -type l \) -delete
# The same skipped loop is what chmod's the Chromium sandbox helper; without
# the setuid bit the bundled web view refuses to start at all.
find "$DT_FILES" -name chrome-sandbox -type f -exec chmod 4755 {} +
for stale in libm.so.6 libstdc++.so.6 libstdc++.so.6.0.25 \
    libgbm.so.1.0.0 libGLX.so.0.0.0 libGLdispatch.so.0.0.0; do
    hit="$(find "$DT_FILES" -name "$stale" \( -type f -o -type l \) -print -quit)"
    if [ -n "$hit" ]; then
        echo "DingTalk still ships an incompatible bundled library: $stale" >&2
        exit 1
    fi
done

# --- 希沃白板 (task: menu entry pointed at a wrapper shell script) --------
# The vendor .desktop runs .../files/com.seewo.easinote5.sh; the real binary
# sits next to it as EasiNote5.  Point the entry at the program, carrying the
# private library path over into a WinduxEdu-owned launcher only when the
# vendor wrapper actually exports one.
EASI_DESKTOP=/usr/share/applications/com.seewo.easinote5.desktop
if [ -s "$EASI_DESKTOP" ]; then
    easinote_dir=/opt/apps/com.seewo.easinote5/files
    easinote_bin="$easinote_dir/EasiNote5"
    if [ ! -x "$easinote_bin" ]; then
        easinote_bin=/opt/EasiNote5/EasiNote5
    fi
    if [ ! -x "$easinote_bin" ]; then
        echo "the EasiNote5 binary is missing" >&2
        exit 1
    fi
    easinote_sh="$easinote_dir/com.seewo.easinote5.sh"
    [ -f "$easinote_sh" ] || easinote_sh=/opt/EasiNote5/com.seewo.easinote5.sh
    easinote_exec="$easinote_bin"
    if [ -f "$easinote_sh" ] && grep -q 'LD_LIBRARY_PATH' "$easinote_sh"; then
        install -Dm755 /dev/stdin /usr/local/bin/winduxedu-easinote5 <<WRAP
#!/bin/sh
# WinduxEdu launcher for 希沃白板: the vendor menu entry pointed at a shell
# wrapper; keep only what that wrapper exported and exec the real program.
export LD_LIBRARY_PATH="$easinote_bin:\${LD_LIBRARY_PATH:-}"
exec "$easinote_bin" "\$@"
WRAP
        easinote_exec=/usr/local/bin/winduxedu-easinote5
    fi
    sed -i "s|^Exec=.*|Exec=$easinote_exec %F|" "$EASI_DESKTOP"
    grep -q "^Exec=$easinote_exec " "$EASI_DESKTOP" || {
        echo "failed to repoint the EasiNote5 menu entry" >&2
        exit 1
    }
    if grep -Eq '^Exec=.*\.sh([[:space:]]|$)' "$EASI_DESKTOP"; then
        echo "the EasiNote5 menu entry still launches a shell script" >&2
        exit 1
    fi
fi

# --- 希沃 upgrade components (task: block vendor self-updates) ------------
# An in-place upgrade would replace a reviewed, pinned build (see the version
# rule in edu-software/README.md), so no vendor update path may stay armed.
for entry in /etc/xdg/autostart/*.desktop; do
    [ -f "$entry" ] || continue
    case "$(basename "$entry")" in
        com.seewo.terminalmanager.desktop | com.cvte.maxhub.alfred.desktop)
            # handled by the 希沃管家 autostart switch above
            continue
            ;;
    esac
    grep -Eiq 'seewo|easinote|easicare|easicamera|cvte|maxhub' "$entry" || continue
    grep -Eiq '^(Name|Name\[zh_CN\]|GenericName|Comment|Exec)=.*(升级|更新|update|upgrade|installer)' "$entry" || continue
    echo "removing vendor updater autostart: $(basename "$entry")"
    rm -f "$entry"
done
for unit in /usr/lib/systemd/system/*.service /lib/systemd/system/*.service /etc/systemd/system/*.service; do
    [ -e "$unit" ] || continue
    base="$(basename "$unit")"
    case "$base" in
        com.seewo.terminalmanager.service | com.cvte.maxhub.alfred.service | \
            disable-seewo-network-card.service | com.ifpdos.udi.hotspot.service)
            continue
            ;;
    esac
    printf '%s' "$base" | grep -Eiq \
        '(seewo|easinote|easicare|easicamera|cvte|maxhub).*(update|upgrade)|(update|upgrade).*(seewo|easinote|cvte|maxhub)' || continue
    echo "masking vendor updater unit: $base"
    mask_unit "$base"
done
# Electron's auto-update feed (app-update.yml) points at the vendor channel.
for tree in /opt/apps/com.seewo.* /opt/EasiNote5; do
    [ -d "$tree" ] || continue
    find "$tree" -maxdepth 5 -type f \
        \( -iname 'app-update.yml' -o -iname 'latest.yml' -o -iname 'update-info.json' \) \
        -exec sh -c 'mv -f "$1" "$1.disabled" 2>/dev/null || true' _ {} \; 2>/dev/null || true
done

# --- ONLYOFFICE (task: default PDF reader) -------------------------------
# Register ONLYOFFICE as the system-wide handler for application/pdf.  The
# package ships no MimeType line for PDF in every release, so make sure the
# desktop entry advertises it before wiring the default.
oo_desktop=
for cand in /usr/share/applications/onlyoffice-desktopeditors.desktop \
    /usr/share/applications/onlyoffice*.desktop; do
    [ -f "$cand" ] || continue
    oo_desktop="$cand"
    break
done
[ -n "$oo_desktop" ] || {
    echo "ONLYOFFICE's desktop entry is missing" >&2
    exit 1
}
oo_entry="$(basename "$oo_desktop")"
if grep -q '^MimeType=' "$oo_desktop"; then
    if ! grep -q '^MimeType=.*application/pdf' "$oo_desktop"; then
        sed -i '0,/^MimeType=/s|^MimeType=|MimeType=application/pdf;|' "$oo_desktop"
    fi
else
    printf 'MimeType=application/pdf;\n' >> "$oo_desktop"
fi
grep -q '^MimeType=.*application/pdf' "$oo_desktop" || {
    echo "ONLYOFFICE does not advertise application/pdf" >&2
    exit 1
}
mkdir -p /etc/xdg
MIMEAPPS=/etc/xdg/mimeapps.list
if [ -f "$MIMEAPPS" ]; then
    # Drop any competing default and re-add ours under [Default Applications].
    grep -v '^application/pdf=' "$MIMEAPPS" > "$MIMEAPPS.tmp" || true
    if grep -q '^\[Default Applications\]' "$MIMEAPPS.tmp"; then
        sed -i "/^\[Default Applications\]/a application/pdf=$oo_entry" "$MIMEAPPS.tmp"
    else
        printf '\n[Default Applications]\napplication/pdf=%s\n' "$oo_entry" >> "$MIMEAPPS.tmp"
    fi
    mv -f "$MIMEAPPS.tmp" "$MIMEAPPS"
else
    printf '[Default Applications]\napplication/pdf=%s\n' "$oo_entry" > "$MIMEAPPS"
fi
grep -qx "application/pdf=$oo_entry" "$MIMEAPPS" || {
    echo "ONLYOFFICE is not the default application/pdf handler" >&2
    exit 1
}

# ONLYOFFICE opens every double-clicked document in a *new* window, which reads
# as "the file opened twice" (field report item 1).  editorWindowMode = true
# keeps a single window with tabs.  Honour an existing key wherever the file
# puts it; when the file is sectioned but has no such key yet, insert it at the
# top of the first section, otherwise append it.
set_oo_window_mode() {
    oo_conf="$1"
    mkdir -p "$(dirname "$oo_conf")"
    if [ -f "$oo_conf" ] &&
        grep -q '^[[:space:]]*editorWindowMode[[:space:]]*=' "$oo_conf"; then
        sed -i "s|^[[:space:]]*editorWindowMode[[:space:]]*=.*|editorWindowMode = true|" \
            "$oo_conf"
    elif [ -f "$oo_conf" ] && grep -q '^\[' "$oo_conf"; then
        awk 'BEGIN { done = 0 }
             /^\[/ && !done { print; print "editorWindowMode = true"; done = 1; next }
             { print }
             END { if (!done) print "editorWindowMode = true" }' \
            "$oo_conf" > "$oo_conf.tmp"
        mv -f "$oo_conf.tmp" "$oo_conf"
    else
        printf 'editorWindowMode = true\n' >> "$oo_conf"
    fi
}
set_oo_window_mode /etc/skel/.config/onlyoffice/DesktopEditors.conf
for oo_user_conf in /home/*/.config/onlyoffice/DesktopEditors.conf; do
    [ -f "$oo_user_conf" ] || continue
    set_oo_window_mode "$oo_user_conf"
done
grep -qx 'editorWindowMode = true' \
    /etc/skel/.config/onlyoffice/DesktopEditors.conf || {
    echo "ONLYOFFICE single-window mode was not written to the skeleton" >&2
    exit 1
}

# --- Windows executables (double-click .exe -> Wine) ------------------------
# ElevenDE routes every file through xdg-open, i.e. through the MIME default in
# /etc/xdg/mimeapps.list.  Nothing claimed application/x-ms-dos-executable, so
# double-clicking a Windows program opened the raw bytes in an editor (or did
# nothing at all), which reads as ".exe 双击无效".
EXE_PROBE=/tmp/winduxedu-probe.exe
printf 'MZ' > "$EXE_PROBE"
EXE_TYPE=""
if command -v xdg-mime >/dev/null 2>&1; then
    EXE_TYPE="$(xdg-mime query filetype "$EXE_PROBE" 2>/dev/null || true)"
fi
if [ "$EXE_TYPE" != "application/x-ms-dos-executable" ]; then
    # shared-mime-info normally ships this type; supply it ourselves when the
    # probe disagrees so the handler below has something to attach to.
    install -Dm644 /dev/stdin /usr/share/mime/packages/winduxedu-windows-program.xml <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-ms-dos-executable">
    <comment>Windows executable program</comment>
    <comment xml:lang="zh_CN">Windows 可执行程序</comment>
    <glob pattern="*.exe"/>
  </mime-type>
</mime-info>
XML
    if command -v update-mime-database >/dev/null 2>&1; then
        update-mime-database /usr/share/mime >/dev/null 2>&1 || true
    fi
fi
rm -f "$EXE_PROBE"

WINE_ENTRY=""
for cand in /usr/share/applications/wine.desktop \
    /usr/share/applications/wine-wine.desktop \
    /usr/share/applications/wine64.desktop; do
    [ -s "$cand" ] || continue
    WINE_ENTRY="$(basename "$cand")"
    if ! grep -q '^MimeType=' "$cand"; then
        printf 'MimeType=application/x-ms-dos-executable;application/x-msi;\n' >> "$cand"
    elif ! grep -q '^MimeType=.*application/x-ms-dos-executable' "$cand"; then
        sed -i '0,/^MimeType=/s|^MimeType=|MimeType=application/x-ms-dos-executable;|' "$cand"
    fi
    break
done
if [ -z "$WINE_ENTRY" ]; then
    install -Dm644 /dev/stdin /usr/local/share/applications/winduxedu-wine.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Wine
Name[zh_CN]=Wine（Windows 程序）
GenericName=Windows Program Runner
Comment=Run a Windows executable with Wine
Comment[zh_CN]=用 Wine 运行 Windows 程序
Exec=wine %f
Icon=wine
Terminal=false
Categories=Utility;
MimeType=application/x-ms-dos-executable;application/x-msi;
EOF
    WINE_ENTRY=winduxedu-wine.desktop
fi

winduxedu_mime_default() {
    # $1 = MIME type, $2 = desktop entry that must open it
    w_mime="$1"
    w_entry="$2"
    MIMEAPPS=/etc/xdg/mimeapps.list
    if [ -f "$MIMEAPPS" ]; then
        grep -v "^$w_mime=" "$MIMEAPPS" > "$MIMEAPPS.tmp" || true
        if grep -q '^\[Default Applications\]' "$MIMEAPPS.tmp"; then
            sed -i "/^\[Default Applications\]/a $w_mime=$w_entry" "$MIMEAPPS.tmp"
        else
            printf '\n[Default Applications]\n%s=%s\n' "$w_mime" "$w_entry" \
                >> "$MIMEAPPS.tmp"
        fi
        mv -f "$MIMEAPPS.tmp" "$MIMEAPPS"
    else
        printf '[Default Applications]\n%s=%s\n' "$w_mime" "$w_entry" > "$MIMEAPPS"
    fi
}
winduxedu_mime_default application/x-ms-dos-executable "$WINE_ENTRY"
winduxedu_mime_default application/x-msi "$WINE_ENTRY"
grep -qx "application/x-ms-dos-executable=$WINE_ENTRY" /etc/xdg/mimeapps.list || {
    echo "application/x-ms-dos-executable has no default handler" >&2
    exit 1
}

# Double-clicking an archive went to Wine's explorer.exe, which has no such
# feature (field report item 4): nothing claimed the archive MIME types, so
# ElevenDE's xdg-open fell through to the Wine fallback.  PeaZip is the
# WinduxEdu archive handler; its record is written by hook 1500 and already
# advertises these types.
[ -s /usr/local/share/applications/peazip.desktop ] || {
    echo "the PeaZip desktop entry is missing" >&2
    exit 1
}
for archive_type in \
    application/zip \
    application/x-7z-compressed \
    application/gzip \
    application/x-gzip \
    application/x-tar \
    application/x-bzip2 \
    application/x-xz \
    application/x-compressed-tar \
    application/x-rar-compressed; do
    winduxedu_mime_default "$archive_type" peazip.desktop
done
grep -qx "application/zip=peazip.desktop" /etc/xdg/mimeapps.list || {
    echo "application/zip has no default handler" >&2
    exit 1
}
# Default image viewer: use Image Viewer (GNOME's eog) instead of Edge.
# eog.desktop is provided by the eog package; ensure it's installed.
# Use the shared winduxedu_mime_default() which is proven to work (PeaZip).
# eog may not be installed yet (package list ordering), so install it if missing.
if ! [ -f /usr/share/applications/eog.desktop ]; then
    echo "eog.desktop not found, installing eog package" >&2
    apt-get update && apt-get install -y --no-install-recommends eog || {
        echo "Failed to install eog" >&2
        exit 1
    }
fi
if [ -f /usr/share/applications/eog.desktop ]; then
    echo "DEBUG: Setting image viewer MIME defaults to eog.desktop" >&2
    for img_type in \
        image/jpeg image/png image/gif image/bmp image/x-ico image/tiff \
        image/webp image/svg+xml image/x-portable-pixmap image/x-portable-bitmap \
        image/x-portable-graymap image/x-xcf image/x-xcf-gimp; do
        echo "DEBUG: Setting $img_type = eog.desktop" >&2
        winduxedu_mime_default "$img_type" eog.desktop
        echo "DEBUG: After winduxedu_mime_default for $img_type:" >&2
        grep "^$img_type=" /etc/xdg/mimeapps.list >&2 || echo "DEBUG: NOT FOUND after setting" >&2
    done
    # Verify all image types were written (mirror PeaZip validation style)
    for img_type in \
        image/jpeg image/png image/gif image/bmp image/x-ico image/tiff \
        image/webp image/svg+xml image/x-portable-pixmap image/x-portable-bitmap \
        image/x-portable-graymap image/x-xcf image/x-xcf-gimp; do
        grep -qx "$img_type=eog.desktop" /etc/xdg/mimeapps.list || {
            echo "Failed to set default for $img_type" >&2
            echo "DEBUG: Full mimeapps.list content:" >&2
            cat /etc/xdg/mimeapps.list >&2
            exit 1
        }
    done
    echo "Image viewer MIME defaults set to eog.desktop"
else
    echo "warning: eog.desktop not found, skipping image viewer MIME defaults" >&2
    ls -la /usr/share/applications/eog.desktop 2>&1 | head -5 >&2
fi

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    update-desktop-database /usr/local/share/applications >/dev/null 2>&1 || true
fi

# The staged DEBs are build-time inputs only; drop them before the squashfs.
rm -rf "$EDU_DIR"

# --- DKMS ---------------------------------------------------------------
# The Seewo postinst registers hugo_firewall and immediately asks for a build.
# Inside the build chroot `uname -r` is the *runner's* Azure kernel, so that
# attempt can only ever fail with
#   Error! Your kernel headers for kernel 6.17.0-1022-azure cannot be found
# and it leaves a half-registered module behind.  On the installed system
# dkms.service then retries the same build at every boot, which is how a
# non-fatal module became boot-time noise.  Settle it here against the kernel
# the image actually ships: build once and the module is ready before the
# first boot, or de-register it so boot has nothing left to attempt.
if command -v dkms >/dev/null 2>&1; then
    mkdir -p /var/log/winduxedu
    dkms autoinstall >/var/log/winduxedu/dkms.log 2>&1 || true
    if dkms status 2>/dev/null | grep -q 'hugo_firewall.*installed'; then
        echo "hugo_firewall was built for the kernel shipped in this image"
    else
        dkms remove -m hugo_firewall --all >>/var/log/winduxedu/dkms.log 2>&1 || true
        echo "hugo_firewall cannot be built here; deregistered so boot stays clean"
    fi
fi

# includes.chroot preserves whatever mode the checkout carries, and a checkout
# from a non-POSIX filesystem can hand the smoke probe over without its bit.
chmod 755 /usr/local/sbin/winduxedu-smoke-diagnostics