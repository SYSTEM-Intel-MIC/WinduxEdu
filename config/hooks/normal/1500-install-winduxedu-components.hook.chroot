#!/bin/sh
set -eu

PKG_DIR=/opt/winduxedu/packages
if [ ! -d "$PKG_DIR" ] || ! ls "$PKG_DIR"/*.deb >/dev/null 2>&1; then
    echo "WinduxEdu component packages are missing: $PKG_DIR" >&2
    exit 1
fi

cd "$PKG_DIR"
sha256sum -c SHA256SUMS
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends ./*.deb

# elevende.deb supplies this path, so write the WinduxEdu terminal profile only
# after package installation.  Otherwise the DEB restores its old CJK primary
# face and dark-grey palette over config/includes.chroot during live-build.
install -d /etc/X11/Xresources.d
cat > /etc/X11/Xresources.d/elevende <<'EOF'
! WinduxEdu X11 typography and terminal profile.
Xft.dpi: 96
Xft.antialias: true
Xft.hinting: true
Xft.hintstyle: hintslight
Xft.rgba: rgb
XTerm*utf8: true
XTerm*locale: true
XTerm*renderFont: true
! xterm #328+ explicit comma fallback chain: fontconfig sort order alone
! never reaches Noto CJK for a DejaVu pattern, so Chinese rendered as boxes.
XTerm*faceName: DejaVu Sans Mono,Noto Sans CJK SC
XTerm*faceSize: 11
! Keep East Asian ambiguous-width punctuation single-column.  Real CJK
! ideographs remain double-width while ASCII character cells stay compact.
XTerm*cjkWidth: false
XTerm*preeditType: None
XTerm*allowWindowOps: true
XTerm*saveLines: 5000
XTerm*background: #000000
XTerm*foreground: #f2f2f2
XTerm*cursorColor: #ffffff
xterm*faceName: DejaVu Sans Mono,Noto Sans CJK SC
xterm*faceSize: 11
xterm*cjkWidth: false
xterm*background: #000000
xterm*foreground: #f2f2f2
xterm*cursorColor: #ffffff
EOF

# RunBox resolves commands through PATH; provide the Windows-compatible command name.
if [ -x /usr/local/bin/linux-regedit ]; then
    ln -sfn /usr/local/bin/linux-regedit /usr/local/bin/regedit
fi

# Desktop integration layer: these declarative overrides preserve each package's
# own executable while giving ElevenDE one session adapter and one Win11 icon
# namespace for the desktop, Start menu, taskbar and custom title bars.
install -d /usr/local/share/applications
# ElevenDE does not read Icon= from desktop files on the desktop surface.  Copy
# the official icon installed by the locked Microsoft Edge DEB into the same
# native theme namespace used by the shell, preserving the microsoft-edge name.
# Edge 143+ no longer ships /usr/share/icons/hicolor entries at all; its logos
# live in /opt/microsoft/msedge/product_logo_<size>.png, so fall back to those.
for size in 16 22 24 32 48 64 96 128; do
    edge_icon="/usr/share/icons/hicolor/${size}x${size}/apps/microsoft-edge.png"
    if [ ! -f "$edge_icon" ]; then
        edge_icon="/opt/microsoft/msedge/product_logo_${size}.png"
    fi
    if [ -f "$edge_icon" ]; then
        install -Dm644 "$edge_icon" \
            "/usr/local/share/elevende-shell/icons/${size}x${size}/apps/microsoft-edge.png"
    fi
done
write_component_entry() {
    file="$1"; name="$2"; name_zh="$3"; icon="$4"; exec_line="$5"; categories="$6"
    cat > "/usr/local/share/applications/$file" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Name[zh_CN]=$name_zh
Comment=$name
Exec=$exec_line
Icon=$icon
Terminal=false
StartupNotify=true
Categories=$categories
EOF
}
ADAPTER=/usr/local/libexec/winduxedu-component-launch
write_component_entry linux-pcmanager.desktop "WinduxEdu PC Manager" "WinduxEdu 电脑管家" linux-pcmanager "$ADAPTER linux-pcmanager" "System;Utility;"
write_component_entry linux-regedit.desktop "注册表编辑器" "注册表编辑器" linux-regedit "$ADAPTER linux-regedit" "System;Settings;"
write_component_entry winduxedu-device-manager.desktop "Device Manager" "设备管理器" winduxedu-device-manager "$ADAPTER devmgr" "System;Settings;HardwareSettings;"
write_component_entry winduxedu-store.desktop "WinduxEdu Store" "WinduxEdu 商店" winduxedu-store "$ADAPTER winduxedu-store" "System;Settings;"
write_component_entry copilot-for-linux.desktop "Copilot for Linux" "Linux Copilot" copilot-for-linux "$ADAPTER /usr/local/bin/winduxedu-copilot %U" "Utility;"
write_component_entry peazip.desktop "PeaZip" "PeaZip 压缩软件" peazip "$ADAPTER peazip %F" "Utility;Archiving;"
write_component_entry winduxedu-troubleshooting.desktop "WinduxEdu Troubleshooting" "WinduxEdu 疑难解答" winduxedu-troubleshooting "$ADAPTER winduxedu-troubleshooting" "Settings;System;"
write_component_entry winduxedu-sticky-keys.desktop "Sticky Keys" "粘滞键" winduxedu-sticky-keys "$ADAPTER winduxedu-sticky-keys" "Settings;Accessibility;"
write_component_entry winduxedu-widgets.desktop "WinduxEdu Widgets" "WinduxEdu 小组件" winduxedu-widgets "$ADAPTER winduxedu-widgets" "Utility;"
write_component_entry winduxedu-windowshit.desktop "WinduxEdu Commands" "WinduxEdu 命令" winduxedu-windowshit "$ADAPTER winduxedu-windowshit" "System;Utility;"
write_component_entry winduxedu-winsat.desktop "WinduxEdu Experience Index" "WinduxEdu 体验指数" winduxedu-winsat "$ADAPTER winsat" "System;Utility;"
write_component_entry winduxedu-winver.desktop "About WinduxEdu" "关于 WinduxEdu" winduxedu-winver "$ADAPTER winver" "System;Settings;"
# PeaZip keeps its real binary inside its own private directory and does not
# always install /usr/bin/peazip, so the bare "peazip" Exec written above can
# resolve to nothing: the entry looks installed but clicking it silently fails
# (the field report's "PeaZip 打不开").  The package is unpacked by now, so
# resolve the real entry point and rewrite the record with an absolute path.
peazip_cmd=peazip
if ! command -v peazip >/dev/null 2>&1; then
    # Strategy 1: ask dpkg for all files from the peazip package, find executables
    if dpkg -l peazip 2>/dev/null | grep -q '^ii'; then
        for f in $(dpkg -L peazip 2>/dev/null); do
            [ -x "$f" ] || continue
            case "$f" in
                */peazip|*/peazip.bin)
                    peazip_cmd="$f"
                    break
                    ;;
            esac
        done
    fi
    # Strategy 2: find any executable named peazip under /usr and /opt
    if [ "$peazip_cmd" = peazip ]; then
        found_peazip="$(find /usr /opt -type f -name 'peazip' 2>/dev/null | while read f; do [ -x "$f" ] && echo "$f" && break; done)"
        if [ -n "$found_peazip" ]; then
            peazip_cmd="$found_peazip"
        fi
    fi
    # Strategy 3: original hardcoded candidates (add peazip.bin)
    if [ "$peazip_cmd" = peazip ]; then
        for peazip_cand in /usr/bin/peazip /usr/lib/peazip/peazip \
            /opt/peazip/peazip /usr/lib/peazip/peazip.bin; do
            [ -x "$peazip_cand" ] || continue
            peazip_cmd="$peazip_cand"
            break
        done
    fi
    # Strategy 4: vendor desktop Exec as last resort
    if [ "$peazip_cmd" = peazip ]; then
        for vendor_peazip in /usr/share/applications/peazip*.desktop; do
            [ -f "$vendor_peazip" ] || continue
            vendor_exec="$(sed -n 's/^Exec=//p' "$vendor_peazip" | head -n1)"
            vendor_exec="${vendor_exec%% *}"
            vendor_exec="$(printf '%s' "$vendor_exec" | tr -d '"')"
            case "$vendor_exec" in
                /*)
                    if [ -x "$vendor_exec" ]; then
                        peazip_cmd="$vendor_exec"
                        break
                    fi
                    ;;
            esac
        done
    fi
fi
if [ "$peazip_cmd" = peazip ]; then
    echo "warning: could not resolve PeaZip's entry point; keeping bare Exec" >&2
else
    echo "PeaZip entry point resolved to $peazip_cmd"
    write_component_entry peazip.desktop "PeaZip" "PeaZip 压缩软件" peazip \
        "$ADAPTER $peazip_cmd %F" "Utility;Archiving;"
fi
# Advertise the archive types on the record WinduxEdu points mimeapps.list at,
# then retire the vendor record so Exec-based de-duplication cannot show two
# PeaZip icons (or hand the menu a second, differently-spelled launcher).
printf 'MimeType=application/zip;application/x-7z-compressed;application/gzip;application/x-gzip;application/x-tar;application/x-bzip2;application/x-xz;application/x-compressed-tar;application/x-rar-compressed;\n' \
    >> /usr/local/share/applications/peazip.desktop
for vendor_peazip in /usr/share/applications/peazip*.desktop; do
    [ -f "$vendor_peazip" ] || continue
    rm -f "$vendor_peazip"
done
# Desktop shortcuts use the same entries as All Apps, avoiding duplicate
# launchers and preserving the package-provided official Edge icon.
install -d /etc/skel/Desktop
install -Dm644 /usr/local/share/applications/linux-regedit.desktop /etc/skel/Desktop/注册表编辑器.desktop
# The Windows-command compatibility package is not a terminal emulator.  Make
# the requested Terminal entry launch XTerm directly, with an explicit black
# palette and a compact DejaVu primary face with Fontconfig CJK fallback,
# instead of inheriting upstream dark-grey resources or mapping the shortcut to
# a one-line helper.
cat > /usr/local/share/applications/xterm.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Terminal
Name[zh_CN]=终端
Comment=WinduxEdu terminal
Exec=xterm -fa "DejaVu Sans Mono,Noto Sans CJK SC" -fs 11 -xrm "XTerm*cjkWidth:false" -xrm "XTerm*background:#000000" -xrm "XTerm*foreground:#f2f2f2" -xrm "XTerm*cursorColor:#ffffff"
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;
StartupWMClass=XTerm
NoDisplay=true
EOF
# Requested: keep XTerm itself, drop it from the Start menu.  The desktop
# shortcut is a separate copy without NoDisplay, so the entry disappears from
# All Apps while the desktop shortcut keeps working.
mkdir -p /etc/skel/Desktop
grep -v '^NoDisplay=' /usr/local/share/applications/xterm.desktop \
    > /etc/skel/Desktop/终端.desktop
chmod 0644 /etc/skel/Desktop/终端.desktop
cat > /etc/skel/Desktop/Microsoft\ Edge.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Microsoft Edge
Name[zh_CN]=Microsoft Edge
Comment=Microsoft Edge web browser
Exec=/usr/bin/microsoft-edge --password-store=basic %U
Icon=microsoft-edge
Terminal=false
StartupNotify=true
Categories=Network;WebBrowser;
EOF
# Override the package desktop entry as well as the desktop shortcut.  The
# local applications directory is scanned before /usr/share/applications, so
# Start, taskbar launch and the desktop all use the same password-store policy.
install -Dm644 /etc/skel/Desktop/Microsoft\ Edge.desktop \
    /usr/local/share/applications/microsoft-edge.desktop
# The local entries above are the single WinduxEdu source of truth.  Remove
# package-provided alternatives whose different Exec values would otherwise
# bypass Shell de-duplication and appear as duplicate All Apps icons.
rm -f /usr/share/applications/winduxedu-sticky-keys.desktop \
      /usr/share/applications/winduxedu-store.desktop \
      /usr/share/applications/winduxedu-widgets.desktop \
      /usr/share/applications/widget-panel.desktop \
      /usr/share/applications/activate-linux.desktop \
      /usr/share/applications/lxqt-leave.desktop \
      /usr/share/applications/lxqt-lockscreen.desktop \
      /usr/share/applications/lxqt-logout.desktop \
      /usr/share/applications/lxqt-reboot.desktop \
      /usr/share/applications/lxqt-shutdown.desktop \
      /usr/share/applications/lxqt-suspend.desktop \
      /usr/share/applications/picom.desktop \
      /usr/share/applications/lxqt-config-session.desktop \
      /usr/share/applications/kbd-layout-viewer5.desktop \
      /usr/share/applications/calamares.desktop \
      /usr/share/applications/install-system.desktop
# Requested: guvcview keeps its package and its command line, but no Start
# menu shortcut (xterm above gets the same treatment via NoDisplay).
rm -f /usr/share/applications/guvcview.desktop \
      /usr/share/applications/guvcview-viewer.desktop
# One terminal entry, one calibrator entry.  Both packages ship their own
# /usr/share/applications record whose Exec differs from the curated local
# copy above, so the shell's Exec-based de-duplication keeps both and Start
# shows "终端" twice (styled vs. stock) and both "Touch Calibration" and
# "Calibrate Touchscreen" for the same touchscreen tool.
rm -f /usr/share/applications/xterm.desktop \
      /usr/share/applications/xinput_calibrator.desktop
# Debian's xterm package does not ship xterm.desktop at all: it ships
# debian-xterm.desktop (Name=XTerm, Exec="xterm %F") and debian-uxterm.desktop
# (Name=UXTerm), so the removal above never matched anything and both records
# stayed visible in All Apps -- that is the "XTerm" icon the field report saw,
# and its bare "xterm" Exec is also why the Start menu terminal came up with
# the wrong font while the desktop shortcut was fine.  Sweep every
# package-provided record whose Exec runs a terminal binary; the curated local
# copy stays (it is NoDisplay) and the desktop shortcut is unaffected.
for stock_terminal in /usr/share/applications/*.desktop; do
    [ -f "$stock_terminal" ] || continue
    if grep -Eq '^Exec=([^[:space:]]*/)?(u|l|koi8r)?xterm([[:space:]]|$)' \
        "$stock_terminal"; then
        echo "Removing stock terminal record from All Apps: $stock_terminal"
        rm -f "$stock_terminal"
    fi
done
# Nothing may leave a *visible* terminal record behind: the Start menu must
# offer the pinned 终端 tile and the desktop shortcut only.
if grep -lE '^Exec=([^[:space:]]*/)?(u|l|koi8r)?xterm([[:space:]]|$)' \
    /usr/share/applications/*.desktop >/dev/null 2>&1; then
    echo "a stock terminal record survived the Start menu sweep" >&2
    exit 1
fi
# OpenSSH ships enabled by default but nothing on WinduxEdu uses it: the QEMU
# smoke boot and the diagnostics probe are serial-console based.  Without host
# keys or a privilege-separation directory the unit starts at every boot and
# immediately lands in the journal as a failed unit, so keep the binaries
# installed (a manual `systemctl start ssh` still works) but not enabled.
if command -v systemctl >/dev/null 2>&1; then
    systemctl disable ssh.service >/dev/null 2>&1 || true
    systemctl disable ssh.socket >/dev/null 2>&1 || true
fi

# Never expose standalone session/power commands as ordinary applications.  The
# Start and SAS power controls remain the only supported routes, so command
# entries cannot bypass their confirmation/authentication policy or appear as
# malformed Chinese duplicates in All Apps.
is_system_command_entry() {
    desktop_file="$1"
    grep -Eqi \
        '^(Name|Name\[zh_CN\]|GenericName|Comment)=.*(Shutdown|Shut Down|Power Off|Restart|Reboot|Log ?Out|Logoff|Logout|Suspend|Sleep|Hibernate|Lock Screen|Lock Session|关机|重启|重新启动|注销|登出|睡眠|挂起|休眠|锁屏|锁定)' \
        "$desktop_file" || \
    grep -Eqi \
        '^Exec=.*(systemctl[[:space:]]+(poweroff|reboot|suspend|hibernate)|loginctl[[:space:]]+(poweroff|reboot|suspend|hibernate|terminate-session|lock-session)|lxqt-leave|xfce4-session-logout|mate-session-save|openbox[[:space:]]+--exit|gnome-session-quit|(^|[[:space:]])(poweroff|reboot|shutdown|logout|logoff|xscreensaver-command|dm-tool)[[:space:]])' \
        "$desktop_file"
}
for desktop_file in /usr/share/applications/*.desktop /usr/local/share/applications/*.desktop; do
    [ -f "$desktop_file" ] || continue
    # Keep the curated, safe WinduxEdu entries even if a future translation adds
    # an English word such as "Update" or "Lock" to a comment.
    case "$(basename "$desktop_file")" in
        microsoft-edge.desktop|linux-regedit.desktop|winduxedu-device-manager.desktop)
            continue
            ;;
    esac
    if is_system_command_entry "$desktop_file"; then
        echo "Removing unsupported All Apps system-command entry: $desktop_file"
        rm -f "$desktop_file"
    fi
done
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications
    update-desktop-database /usr/local/share/applications
fi

# Widgets are a WinduxEdu desktop surface, not a utility the user must manually
# launch once before its own per-user preference is written.
install -Dm644 /dev/stdin /etc/xdg/autostart/winduxedu-widgets.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=WinduxEdu Widgets
Name[zh_CN]=Windows 小组件
Exec=/usr/local/libexec/winduxedu-component-launch /usr/bin/winduxedu-widgets
OnlyShowIn=ElevenDE;
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF

# Automount removable media (USB drives, SD cards) via udisks2.
# This udev rule triggers udisksctl mount when a block device with a filesystem
# appears, so USB sticks and SD cards appear on the desktop automatically.
install -Dm644 /dev/stdin /etc/udev/rules.d/99-winduxedu-automount.rules <<'EOF'
# WinduxEdu: auto-mount removable block devices with a filesystem
ACTION=="add", KERNEL=="sd*|mmcblk*", SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="?*", \
    RUN+="/usr/bin/udisksctl mount -b /dev/%k --no-user-interaction"
EOF
udevadm control --reload-rules || true

# Packages are installed; keeping their archives only increases the ISO.
rm -rf "$PKG_DIR"
mkdir -p /usr/share/winduxedu
cat > /usr/share/winduxedu/components.txt <<'EOF'
WinduxEdu 1.0 bundled components
- ElevenDE 3.5.1 (published fixed source revision)
- LinuxPCManager, linux-regedit and winduxedu-device-manager
- WinduxEdu Store, with its APT-backed package workflow and ElevenDE integration
- Copilot for Linux 1.0.0 amd64 DEB (SHA-256 verified; no API key)
- PeaZip 11.2.0 Qt6 official DEB
- WinduxEdu Troubleshooting
- Sticky Keys and Widgets
- Namespaced Windows command compatibility tools and Windows Experience Index
- About WinduxEdu (winver)
- windowsuninstaller/mmclinux is not bundled: its requested public source was unavailable during audit
EOF
