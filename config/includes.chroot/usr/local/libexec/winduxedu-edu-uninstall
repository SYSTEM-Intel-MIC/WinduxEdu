#!/bin/sh
# Root-side one-click uninstaller for a single 希沃 application.  Invoked only
# through /usr/local/libexec/winduxedu-privileged-action (edu-uninstall).
# The package list is a fixed allow-list of the four proprietary Seewo
# packages WinduxEdu collects; nothing else can be reached from here.
set -eu

pkg="${1:-}"

case "$pkg" in
    com.seewo.easinote5 | com.seewo.terminalmanager | com.seewo.easicare | \
        com.seewo.easicamera | com.seewo.easisidebar | \
        com.seewo.easiminiapps.desktopscreenshot | com.seewo.easiminiapps.desktoptimer | \
        com.seewo.easiminiapps.luckyrandom | com.seewo.easiminiapps.rollcall)
        ;;
    *)
        echo "winduxedu-edu-uninstall: not an allow-listed package: $pkg" >&2
        exit 64
        ;;
esac

if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q '^install ok installed$'; then
    echo "winduxedu-edu-uninstall: $pkg is not installed" >&2
    exit 5
fi

export DEBIAN_FRONTEND=noninteractive
# remove (not purge): the vendor keeps its per-user profile under /home, and
# the user may reinstall the same pinned version later from edu-software.
apt-get remove -y "$pkg"
echo "winduxedu-edu-uninstall: removed $pkg"
