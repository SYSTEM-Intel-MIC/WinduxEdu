#!/usr/bin/env python3
"""WinduxEdu screen keyboard supervisor.

Started from the patched elevende-session *before* the ElevenDE login gate, so
the same supervisor covers the login screen and the desktop session.

Switch:  教育版设置 → 屏幕键盘  (writes screen-keyboard=0|1 to
~/.config/winduxedu/edu-settings.conf; the defaults file in
/etc/winduxedu/edu-settings.conf supplies the fallback).

Showing rule:
  1. elevende-lock running  → show.  The lock/login window grabs the keyboard,
     so matchbox-keyboard's XTEST events land exactly in the password field.
  2. a focused AT-SPI2 widget is editable → show.  GTK/Qt/Chromium editors,
     dialogs and terminals all publish this state.
  3. the focused window class is a known text-entry app → show (fallback for
     toolkits without an accessibility bridge).
  otherwise → hide.

matchbox-keyboard (Debian package matchbox-keyboard, GPL-2-or-later, Matchbox
project) is the keyboard implementation; its licence text ships at
/usr/share/doc/matchbox-keyboard/copyright.
"""
from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import threading
import time

CONF_KEYS = "screen-keyboard"
DEFAULTS_CONF = "/etc/winduxedu/edu-settings.conf"
POLL = 0.5
A11Y_BUDGET = 256
TEXT_CLASSES = ("xterm", "elevende-notepad", "elevende-runbox")

LOCK_PROCS = ("elevende-lock",)

LOG_PATH = "/tmp/winduxedu-winduxedu-oskd.log"


def log(msg: str) -> None:
    try:
        with open(LOG_PATH, "a", encoding="utf-8") as fh:
            fh.write("oskd: %s\n" % msg)
    except OSError:
        pass


def read_conf(user_path: str, key: str, fallback: str) -> str:
    """User file first, then the system defaults, then `fallback`."""
    for path in (user_path, DEFAULTS_CONF):
        try:
            with open(path, "r", encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if line.startswith(key + "="):
                        return line.split("=", 1)[1].strip()
        except OSError:
            continue
    return fallback


def process_running(names) -> bool:
    """True when one of `names` is a live process of this user."""
    try:
        import glob

        for stat in glob.glob("/proc/[0-9]*/stat"):
            try:
                with open(stat, "r", encoding="utf-8", errors="replace") as fh:
                    data = fh.read()
            except OSError:
                continue
            # comm may contain spaces/parens; everything after the final ')'
            # is state/pid/ppid/... so the comm is the first parenthesised run.
            m = re.match(r"^\s*\d+ \((.*)\) (.*)$", data)
            if not m:
                continue
            if m.group(1) in names:
                return True
    except Exception:
        pass
    return False


# ---------------------------------------------------------------- a11y query
_a11y_state = {"busy": False, "editable": False}
try:  # pragma: no cover - availability depends on the image
    import pyatspi  # type: ignore
except Exception:  # ImportError or a broken D-Bus session
    pyatspi = None  # type: ignore


def _focused_editable(desktop) -> bool:
    budget = [A11Y_BUDGET]

    def walk(node, depth):
        if depth > 12 or budget[0] <= 0:
            return None
        try:
            count = min(int(node.childCount), 48)
        except Exception:
            return None
        for i in range(count):
            budget[0] -= 1
            if budget[0] <= 0:
                return None
            try:
                child = node.getChildAtIndex(i)
            except Exception:
                return None
            if child is None:
                continue
            try:
                state = child.getState()
            except Exception:
                continue
            if state.contains(pyatspi.STATE_FOCUSED):
                return child
            if state.contains(pyatspi.STATE_ACTIVE):
                found = walk(child, depth + 1)
                if found is not None:
                    return found
        return None

    focused = walk(desktop, 0)
    if focused is None:
        return False
    try:
        state = focused.getState()
        if not state.contains(pyatspi.STATE_EDITABLE):
            return False
        return bool(
            state.contains(pyatspi.STATE_FOCUSED)
            or state.contains(pyatspi.STATE_ACTIVE)
        )
    except Exception:
        return False


def a11y_worker() -> None:
    """Never let a wedged accessibility bus stall the supervisor."""
    while True:
        if _a11y_state["busy"]:
            time.sleep(POLL)
            continue
        if pyatspi is None:
            time.sleep(2)
            continue
        _a11y_state["busy"] = True
        try:
            desktop = pyatspi.Registry.getDesktop(0)
            _a11y_state["editable"] = bool(
                desktop is not None and _focused_editable(desktop)
            )
        except Exception:
            _a11y_state["editable"] = False
        finally:
            _a11y_state["busy"] = False
        time.sleep(POLL)


# ----------------------------------------------------------- X window queries
def focused_window_class() -> str:
    try:
        wid = subprocess.run(
            ["xdotool", "getactivewindow"],
            capture_output=True,
            text=True,
            timeout=2,
        ).stdout.strip()
    except Exception:
        return ""
    if not wid:
        return ""
    try:
        out = subprocess.run(
            ["xprop", "-id", wid, "WM_CLASS"],
            capture_output=True,
            text=True,
            timeout=2,
        ).stdout
    except Exception:
        return ""
    return out.lower()


# ------------------------------------------------------------ keyboard window
class Keyboard:
    def __init__(self) -> None:
        self.proc = None
        self.shown_at = 0.0
        self.last_raise = 0.0

    def show(self) -> None:
        if self.proc is None or self.proc.poll() is not None:
            try:
                self.proc = subprocess.Popen(
                    ["matchbox-keyboard"], start_new_session=True
                )
                self.shown_at = time.time()
                log("keyboard started")
            except OSError as exc:
                log("cannot start matchbox-keyboard: %s" % exc)
                self.proc = None
                return
        if time.time() - self.shown_at < 6:
            return
        if time.time() - self.last_raise < 5:
            return
        # Keep the keyboard above the lock window and the ElevenDE taskbar
        # without ever taking focus away from the password field: locate the
        # window by title and only set _NET_WM_STATE_ABOVE.
        try:
            listing = subprocess.run(
                ["wmctrl", "-l", "-x"],
                capture_output=True,
                text=True,
                timeout=2,
            ).stdout
        except Exception:
            return
        for line in listing.splitlines():
            parts = line.split(None, 3)
            if len(parts) < 4:
                continue
            if "keyboard" not in parts[3].lower():
                continue
            try:
                subprocess.run(
                    ["wmctrl", "-i", "-r", parts[0], "-b", "add,above"],
                    capture_output=True,
                    timeout=2,
                )
                self.last_raise = time.time()
            except Exception:
                pass

    def hide(self) -> None:
        if self.proc is None:
            return
        if self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=2)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass
            log("keyboard hidden")
        self.proc = None


def main() -> int:
    if not shutil.which("matchbox-keyboard"):
        log("matchbox-keyboard is not installed")
        return 0
    if not os.environ.get("DISPLAY"):
        log("no DISPLAY")
        return 0

    user_conf = os.path.join(
        os.environ.get(
            "XDG_CONFIG_HOME", os.path.join(os.environ.get("HOME", ""), ".config")
        ),
        "winduxedu",
        "edu-settings.conf",
    )
    threading.Thread(target=a11y_worker, daemon=True).start()

    kb = Keyboard()
    last = None
    while True:
        enabled = read_conf(user_conf, CONF_KEYS, "0") == "1"
        show = False
        reason = ""
        if enabled:
            if process_running(LOCK_PROCS):
                show, reason = True, "login/lock window"
            elif _a11y_state["editable"]:
                show, reason = True, "focused editable widget"
            else:
                cls = focused_window_class()
                if cls and any(c in cls for c in TEXT_CLASSES):
                    show, reason = True, "text-entry window class"

        if show:
            kb.show()
        else:
            kb.hide()

        state = (enabled, show, reason)
        if state != last:
            last = state
            log("enabled=%s show=%s reason=%s" % (enabled, show, reason or "-"))

        time.sleep(POLL)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        pass
