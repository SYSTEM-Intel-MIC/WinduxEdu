#!/bin/sh
# WinduxEdu desktop shortcut repair.
#
# Opening one of the Seewo applications writes a .desktop record of its own,
# and the record it writes often has no Name/Icon/Exec: the shell renders that
# as a blank icon the user cannot click (field report item 7).  The same launch
# also drops a record *next to* the shortcut the image already ships, so the
# desktop ends up with two identically labelled icons for one application
# (field report: 希沃白板启动时会在桌面又放一个快捷方式导致多个快捷方式).  Sweep
# the two places such a record can appear, restore it from the packaged entry
# when the id is still known, drop it when nothing usable is left, and keep
# exactly one record per launcher.
#
# A record can also be complete and still draw nothing: an Icon= the shell
# cannot open -- no value at all, a path to a file that is not there, or a
# bare name with no art in any namespace the shell searches -- falls back to
# the generic glyph.  Those get a value the shell really resolves.
#
# Runs in the foreground on purpose: the session script tracks its helpers by
# pid file, so a helper must never fork itself away.
set -u

POLL=10

log() {
    echo "desktop-tidy: $*"
}

repair_dir() {
    dir="$1"
    [ -d "$dir" ] || return 0
    for entry in "$dir"/*.desktop; do
        [ -f "$entry" ] || continue
        id="$(basename "$entry" .desktop)"
        if [ ! -s "$entry" ]; then
            log "removing empty record $entry"
            rm -f "$entry"
            continue
        fi
        if ! grep -q '^Name=' "$entry" || ! grep -q '^Exec=' "$entry"; then
            fixed=""
            for src in "/usr/share/applications/$id.desktop" \
                "/usr/local/share/applications/$id.desktop"; do
                [ -s "$src" ] || continue
                # Never "repair" a broken record with another broken one.
                grep -q '^Name=' "$src" && grep -q '^Exec=' "$src" || continue
                cp -f "$src" "$entry"
                fixed="$src"
                break
            done
            if [ -n "$fixed" ]; then
                log "restored $entry from $fixed"
            else
                log "removing unusable record $entry"
                rm -f "$entry"
                continue
            fi
        fi
        # Those flags belong to the application menu.  On the desktop they can
        # only produce an icon that refuses to render or to launch.
        if grep -q '^NoDisplay=true' "$entry" || grep -q '^Hidden=true' "$entry"; then
            sed -i -e '/^NoDisplay=/d' -e '/^Hidden=/d' "$entry"
            log "unhid $entry"
        fi
        fix_icon "$entry" "$id"
    done
}

# Mirror ElevenDE theme_find(): decide whether an Icon= value can really be
# opened where the shell looks.  A value that fails here renders as the blank
# generic glyph, which is the field report's "有条目但图标空白/通用图".
icon_renders() {
    ic_name="$1"
    [ -n "$ic_name" ] || return 1
    case "$ic_name" in
    /*)
        # A path is kept in the record's own field, so it only has to be short
        # enough to fit and to point at something that exists.  The build widens
        # that field to 256 bytes (scripts/patch-elevende-desktop-launcher.py),
        # so the ~78-character vendor paths do survive -- what is left to catch
        # is a value too long to fit or pointing at a file that is not there,
        # since theme_find() only runs access() on an absolute name and then
        # gives up with no fallback.
        [ "${#ic_name}" -ge 256 ] && return 1
        [ -r "$ic_name" ] || return 1
        return 0
        ;;
    esac
    for ic_sz in 32 48 64 128 256 512; do
        for ic_ext in png svg; do
            ic_try="/usr/local/share/elevende-shell/icons/${ic_sz}x${ic_sz}/apps/${ic_name}.${ic_ext}"
            [ -r "$ic_try" ] && return 0
        done
    done
    for ic_try in "/usr/local/share/elevende-shell/icons/scalable/apps/${ic_name}.png" \
        "/usr/local/share/elevende-shell/icons/scalable/apps/${ic_name}.svg" \
        "/usr/share/pixmaps/${ic_name}.png" \
        "/usr/share/pixmaps/${ic_name}.svg"; do
        [ -r "$ic_try" ] && return 0
    done
    for ic_theme in hicolor Adwaita Papirus Kali gnome Adwaita-Dark; do
        for ic_sz in 16 22 24 32 48 64 96 128 256 512; do
            for ic_ext in png svg; do
                ic_try="/usr/share/icons/${ic_theme}/${ic_sz}x${ic_sz}/apps/${ic_name}.${ic_ext}"
                [ -r "$ic_try" ] && return 0
            done
        done
        for ic_ext in png svg; do
            ic_try="/usr/share/icons/${ic_theme}/scalable/apps/${ic_name}.${ic_ext}"
            [ -r "$ic_try" ] && return 0
        done
    done
    return 1
}

# Icon= of the [Desktop Entry] group only.  An Action group carries its own
# Icon= for that action's launcher; reading it as the application's icon (or
# overwriting it) leaves the entry itself with nothing to draw.
desktop_icon_of() {
    awk '
        /^\[/ { h = $0; sub(/\r$/, "", h); in_de = (h == "[Desktop Entry]"); next }
        in_de && /^Icon=/ { sub(/^Icon=/, ""); sub(/\r$/, ""); print; exit }' "$1"
}

# Give an unrenderable Icon= something the shell can actually open: the value
# the packaged entry carries, otherwise the art hook 1550 published under the
# record's own id.  Never touches a value that already resolves.
fix_icon() {
    fi_entry="$1"
    fi_id="$2"
    fi_cur="$(desktop_icon_of "$fi_entry")"
    icon_renders "$fi_cur" && return 0

    fi_pick=""
    for fi_src in "/usr/share/applications/$fi_id.desktop" \
        "/usr/local/share/applications/$fi_id.desktop"; do
        [ -s "$fi_src" ] || continue
        fi_cand="$(desktop_icon_of "$fi_src")"
        [ -n "$fi_cand" ] || continue
        [ "$fi_cand" = "$fi_cur" ] && continue
        icon_renders "$fi_cand" || continue
        fi_pick="$fi_cand"
        break
    done
    if [ -z "$fi_pick" ] && icon_renders "$fi_id"; then
        fi_pick="$fi_id"
    fi
    if [ -z "$fi_pick" ]; then
        log "no renderable art for Icon=${fi_cur:-<none>} in $fi_entry"
        return 0
    fi
    if [ -n "$fi_cur" ]; then
        # Replace the entry group's Icon= only; the Action groups keep theirs.
        awk -v pick="$fi_pick" '
            /^\[/ { h = $0; sub(/\r$/, "", h); in_de = (h == "[Desktop Entry]"); print; next }
            in_de && !done && /^Icon=/ { print "Icon=" pick; done = 1; next }
            { print }' "$fi_entry" >"$fi_entry.tmp"
    else
        # No Icon= at all: add it inside [Desktop Entry], not at the end of
        # the file where it would land in an Action group.
        awk -v pick="$fi_pick" '
            { print }
            /^\[Desktop Entry\]\r*$/ && !done { print "Icon=" pick; done = 1 }' \
            "$fi_entry" >"$fi_entry.tmp"
    fi
    cp -f "$fi_entry.tmp" "$fi_entry" && rm -f "$fi_entry.tmp"
    if [ "$(desktop_icon_of "$fi_entry")" = "$fi_pick" ]; then
        log "repaired icon of $fi_entry: ${fi_cur:-<none>} -> $fi_pick"
    else
        log "failed to repair icon of $fi_entry"
    fi
}

# A package id (com.seewo.easinote5) is what the vendor drops; the shortcut the
# image ships carries a human name (希沃白板).  Nothing else tells the two apart,
# and both are legitimate on their own.
is_package_id() {
    case "$1" in
    com.* | org.* | io.* | net.* | de.* | fr.* | cn.*) return 0 ;;
    esac
    return 1
}

# entry_exec_token <file>: first word of the [Desktop Entry] Exec= line, i.e.
# the program the record starts without its arguments and field codes.
entry_exec_token() {
    sed -n 's/^Exec=//p' "$1" | head -n 1 | awk '{ print $1 }'
}

# entry_name <file>: the untranslated Name= of [Desktop Entry].
entry_name() {
    sed -n 's/^Name=//p' "$1" | head -n 1
}

# claimed <blob> <key>: true when <key> is already one of the newline-separated
# values in <blob>.  Entries are compared whole (the value must be delimited by a
# newline or the end of the blob), so name:视频展台 never matches name:视频展台1.
claimed() {
    case "$1" in
    *"
$2
"*) return 0 ;;
    *"
$2") return 0 ;;
    esac
    return 1
}

# dedupe_rank <file>: which of two records that point at the same launcher wins.
# 1 is a shortcut the image itself ships (/etc/skel/Desktop carries the same file
# name), 2 is any other hand-named record, 3 is the package-id copy the vendor
# drops next to it.  The lower rank is processed first, so the record the image
# intended both keeps its place and owns the Name=/Exec= claims.
dedupe_rank() {
    dedup_r_id="$(basename "$1" .desktop)"
    if [ -f "/etc/skel/Desktop/$dedup_r_id.desktop" ]; then
        echo 1
    elif is_package_id "$dedup_r_id"; then
        echo 3
    else
        echo 2
    fi
}

# Keep exactly one record per launcher.  Opening a Seewo application copies the
# vendor's own .desktop next to the shortcut the image ships, and the copy
# carries the same Name= and Exec= as that shortcut, so the desktop shows two
# identically labelled icons (field report: 希沃白板启动时会在桌面又放一个快捷方式
# 导致多个快捷方式).  The repair pass above has just given every record a usable
# Name=/Exec=, so group by those two values and drop the copy.  Records with no
# Name= and no Exec= cannot be grouped and are left where they are -- repair_dir()
# already removed those.
dedupe_dir() {
    dd_dir="$1"
    [ -d "$dd_dir" ] || return 0
    dd_claims=""
    dd_rank=0
    while [ "$dd_rank" -lt 3 ]; do
        dd_rank=$((dd_rank + 1))
        for dd_entry in "$dd_dir"/*.desktop; do
            [ -f "$dd_entry" ] || continue
            [ "$(dedupe_rank "$dd_entry")" -eq "$dd_rank" ] || continue
            dd_exec="$(entry_exec_token "$dd_entry")"
            dd_name="$(entry_name "$dd_entry")"
            dd_key=""
            if [ -n "$dd_exec" ] && claimed "$dd_claims" "exec:$dd_exec"; then
                dd_key="exec:$dd_exec"
            elif [ -n "$dd_name" ] && claimed "$dd_claims" "name:$dd_name"; then
                dd_key="name:$dd_name"
            fi
            if [ -n "$dd_key" ]; then
                log "removing duplicate record $dd_entry (${dd_key#*:} is already on the desktop)"
                rm -f "$dd_entry"
                continue
            fi
            if [ -n "$dd_exec" ]; then
                dd_claims="$dd_claims
exec:$dd_exec"
            fi
            if [ -n "$dd_name" ]; then
                dd_claims="$dd_claims
name:$dd_name"
            fi
        done
    done
}

while :; do
    # Repair every directory the shell might be drawing from.  ElevenDE reads
    # $HOME/Desktop directly while xdg-user-dir DESKTOP answers ~/桌面 in a
    # zh_CN session, so fixing only one of them leaves the records the shell
    # actually renders untouched.
    repair_dir "$HOME/Desktop"
    repair_dir "$HOME/桌面"
    user_desktop=""
    if command -v xdg-user-dir >/dev/null 2>&1; then
        user_desktop="$(xdg-user-dir DESKTOP 2>/dev/null)"
        [ -n "$user_desktop" ] && repair_dir "$user_desktop"
    fi
    repair_dir "$HOME/.local/share/applications"
    # Only the directories the shell draws icons from are de-duplicated: the
    # application menu may legitimately hold two entries with one display name.
    dedupe_dir "$HOME/Desktop"
    dedupe_dir "$HOME/桌面"
    [ -n "$user_desktop" ] && dedupe_dir "$user_desktop"
    sleep "$POLL"
done
