#!/bin/sh
# WinduxEdu 教育版设置 helper (called by the ElevenDE Settings app page
# "教育版设置" and usable by hand from a terminal).
#
#   winduxedu-edu-settings get <key>            effective value (read only)
#   winduxedu-edu-settings set <key> <value>    write; escalates system keys
#   winduxedu-edu-settings status               every key as key=value
#   winduxedu-edu-settings list-seewo           installed 希沃 packages
#   winduxedu-edu-settings uninstall-seewo <p>  ask for one-click removal
#
# Per-user keys live in ~/.config/winduxedu/edu-settings.conf, system keys in
# /etc/winduxedu/edu-settings.conf (defaults shipped by the image).  The
# system keys are applied by /usr/local/libexec/winduxedu-privileged-action,
# which only ever executes fixed, allow-listed operations.
set -eu

PRIV=/usr/local/libexec/winduxedu-privileged-action
USER_CONF="${XDG_CONFIG_HOME:-${HOME:-}/.config}/winduxedu/edu-settings.conf"
SYS_CONF=/etc/winduxedu/edu-settings.conf

USER_KEYS="screen-keyboard touch-calibration"
SYS_KEYS="seewo-autostart sidebar-autostart"

die() { echo "winduxedu-edu-settings: $*" >&2; exit "${2:-1}"; }

# Every system-level operation leaves the desktop through pkexec.  The settings
# page used to start this script with QProcess::startDetached(), which discards
# both the exit status and stderr, so a refusal was invisible and the page just
# un-checked itself two seconds later.  Keep pkexec's own message (it is the
# only place that says *why*) in a user-readable file and repeat it on stderr,
# then propagate the real exit code so the caller can report it.
escalate() {
    rc=0
    logdir="${XDG_CACHE_HOME:-${HOME:-}/.cache}/winduxedu"
    if mkdir -p "$logdir" 2>/dev/null && [ -w "$logdir" ]; then
        logfile="$logdir/edu-escalation.log"
        pkexec "$@" 2>"$logfile" || rc=$?
        if [ "$rc" -ne 0 ]; then
            {
                printf '%s: pkexec exit %s: %s\n' \
                    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$rc" "$*"
                if [ -s "$logfile" ]; then
                    sed 's/^/    /' "$logfile"
                else
                    echo "    (pkexec reported nothing on stderr)"
                fi
            } >&2
        fi
        return "$rc"
    fi
    # No writable cache directory: let pkexec keep its own diagnostics instead
    # of dropping them into a file that could not be created.
    pkexec "$@"
}

is_user_key() {
    case " $USER_KEYS " in *" $1 "*) return 0 ;; esac
    return 1
}

is_sys_key() {
    case " $SYS_KEYS " in *" $1 "*) return 0 ;; esac
    return 1
}

default_for() {
    case "$1" in
        touch-calibration) echo "1 0 0 0 1 0 0 0 1" ;;
        *) echo "0" ;;
    esac
}

valid_value() {
    key="$1" value="$2"
    case "$key" in
        touch-calibration)
            printf '%s' "$value" |
                grep -Eq '^-?[0-9]+(\.[0-9]+)?( +-?[0-9]+(\.[0-9]+)?){8}$'
            ;;
        *)
            case "$value" in
                0|1) return 0 ;;
                *) return 1 ;;
            esac
            ;;
    esac
}

read_key() {
    key="$1" value=""
    value="$(sed -n "s/^${key}=//p" "$USER_CONF" 2>/dev/null | tail -n 1)" || true
    if [ -z "$value" ]; then
        value="$(sed -n "s/^${key}=//p" "$SYS_CONF" 2>/dev/null | tail -n 1)" || true
    fi
    if [ -z "$value" ]; then
        value="$(default_for "$key")"
    fi
    printf '%s\n' "$value"
}

write_user_key() {
    key="$1" value="$2"
    dir="$(dirname "$USER_CONF")"
    mkdir -p "$dir"
    tmp="$USER_CONF.tmp.$$"
    if [ -f "$USER_CONF" ]; then
        grep -v "^${key}=" "$USER_CONF" >"$tmp" || true
    else
        : >"$tmp"
    fi
    printf '%s=%s\n' "$key" "$value" >>"$tmp"
    mv -f "$tmp" "$USER_CONF"
}

# 教育版设置 → 启用桌面侧边栏 used to write /etc/xdg/autostart and nothing
# else, so flipping the switch changed nothing the user could see until the
# next login.  Start the sidebar in the running session too.  This script runs
# inside the user's own session (the Settings page starts it), so it already
# carries the right DISPLAY and XAUTHORITY -- the root-side applier deliberately
# has no access to them.
start_sidebar_now() {
    sidebar_entry=/etc/xdg/autostart/com.seewo.easisidebar.desktop
    [ -s "$sidebar_entry" ] || return 0
    sidebar_prog="$(sed -n 's/^Exec=//p' "$sidebar_entry" |
        head -n 1 | awk '{ print $1 }')"
    [ -n "$sidebar_prog" ] || return 0
    [ -x "$sidebar_prog" ] || return 0
    if command -v pgrep >/dev/null 2>&1; then
        # Already running: the switch must not start a second copy.
        if pgrep -f "$sidebar_prog" >/dev/null 2>&1; then
            return 0
        fi
    fi
    # Detach it so it outlives this helper (and the Settings page's QProcess).
    if command -v setsid >/dev/null 2>&1; then
        setsid "$sidebar_prog" >/dev/null 2>&1 &
    else
        "$sidebar_prog" >/dev/null 2>&1 &
    fi
    echo "winduxedu-edu-settings: started the desktop sidebar"
}

seewo_label() {
    case "$1" in
        com.seewo.easinote5) echo "希沃白板5" ;;
        com.seewo.terminalmanager) echo "希沃管家" ;;
        com.seewo.easicare) echo "班级优化大师" ;;
        com.seewo.easicamera) echo "视频展台" ;;
        com.seewo.easisidebar) echo "希沃侧边栏" ;;
        com.seewo.easiminiapps.desktopscreenshot) echo "桌面截屏" ;;
        com.seewo.easiminiapps.desktoptimer) echo "桌面计时器" ;;
        com.seewo.easiminiapps.luckyrandom) echo "随机抽选" ;;
        com.seewo.easiminiapps.rollcall) echo "人数统计" ;;
        com.seewo.easiminiapps.desktopinkannotation) echo "桌面批注" ;;
        *) echo "$1" ;;
    esac
}

installed_seewo() {
    dpkg-query -W -f='${Package}\n' 2>/dev/null | sed -n '/^com\.seewo\./p' |
        while read -r pkg; do
            [ -n "$pkg" ] || continue
            printf '%s\t%s\n' "$pkg" "$(seewo_label "$pkg")"
        done
}

cmd="${1:-}"
case "$cmd" in
    get)
        [ "$#" -eq 2 ] || die "usage: get <key>" 64
        is_user_key "$2" || is_sys_key "$2" || die "unknown key: $2" 64
        read_key "$2"
        ;;
    status)
        [ "$#" -eq 1 ] || die "usage: status" 64
        for key in $USER_KEYS $SYS_KEYS; do
            printf '%s=%s\n' "$key" "$(read_key "$key")"
        done
        ;;
    set)
        [ "$#" -eq 3 ] || die "usage: set <key> <value>" 64
        key="$2" value="$3"
        is_user_key "$key" || is_sys_key "$key" || die "unknown key: $key" 64
        valid_value "$key" "$value" || die "invalid value for $key: $value" 64
        if is_user_key "$key"; then
            write_user_key "$key" "$value"
        else
            # System keys are applied as root through the fixed dispatcher.
            # Run it to completion and keep its exit status: an unobserved
            # pkexec is what made the switch look like it "auto-un-checked".
            rc=0
            escalate "$PRIV" edu-set "$key" "$value" || rc=$?
            if [ "$rc" -ne 0 ]; then
                echo "winduxedu-edu-settings: cannot apply $key=$value (pkexec exit $rc)" >&2
                exit "$rc"
            fi
            # Adding the autostart entry alone left the switch looking dead, so
            # 启用桌面侧边栏 also starts the sidebar right here and now.
            if [ "$key" = sidebar-autostart ] && [ "$value" = 1 ]; then
                start_sidebar_now
            fi
        fi
        ;;
    list-seewo)
        [ "$#" -eq 1 ] || die "usage: list-seewo" 64
        installed_seewo
        ;;
    uninstall-seewo)
        [ "$#" -eq 2 ] || die "usage: uninstall-seewo <package>" 64
        pkg="$2"
        installed_seewo | cut -f1 | grep -Fxq "$pkg" ||
            die "$pkg is not an installed 希沃 package" 64
        rc=0
        escalate "$PRIV" edu-uninstall "$pkg" || rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "winduxedu-edu-settings: cannot uninstall $pkg (pkexec exit $rc)" >&2
            exit "$rc"
        fi
        ;;
    *)
        die "usage: get|set|status|list-seewo|uninstall-seewo [...]" 64
        ;;
esac
