#!/bin/sh
# Native systemd display/session launcher for ElevenDE on WinduxEdu.
# Xorg must retain the system service's VT ownership; the ElevenDE client is
# nevertheless always run as the selected unprivileged session user.
set -eu

# Everything this script learns about VT activation, Xorg readiness and session
# lifetime is only written to the journal, which the QEMU smoke run never sees.
# Mirror the decisive milestones onto the serial console so a black captured
# frame can be root-caused from the CI log alone.  Best effort by design: a
# machine without a serial port simply skips every marker.
SERIAL=/dev/ttyS0
ser() {
    [ -w "$SERIAL" ] || return 0
    printf 'winduxedu-elevende-display: %s\n' "$*" >>"$SERIAL" 2>/dev/null || true
}

# The QEMU smoke run is the only reader, and it keeps the tail of the serial
# console: a guest that dies quietly is indistinguishable from one that never
# started.  Record what the session and the server logged at the moment they
# failed -- once per display service, because the very failure being explained
# tends to repeat, and 130 copies of the same report would push the first (the
# only useful) one out of the window.
EVIDENCE_DONE=""
dump_failure_evidence() {
    [ -n "$EVIDENCE_DONE" ] && return 0
    EVIDENCE_DONE=yes
    # Boot-scoped as well as process-scoped: when the service itself is
    # restarted, every instance would otherwise write its own copy and the
    # stack of them would push the first -- the one taken at the original
    # failure -- out of the retained tail.
    [ -e /run/winduxedu-display-evidence ] && return 0
    touch /run/winduxedu-display-evidence 2>/dev/null || true
    [ -w "$SERIAL" ] || return 0
    # Sized so the whole report still fits in the retained tail together with
    # the boot log and the probe output: everything past the window is gone.
    {
        echo "--- display service failure evidence ---"
        echo "--- journal (display service, last 40) ---"
        journalctl -u winduxedu-elevende-display -b --no-pager -n 40 \
            2>/dev/null || true
        echo "--- session/shell logs (last 15 each) ---"
        for f in /tmp/elevende-shell.log /tmp/elevende-picom.log \
                 /tmp/elevende-keybind.log /tmp/elevende-notifyd.log \
                 /tmp/elevende-sas.log; do
            [ -s "$f" ] || continue
            echo ">>> $f"
            tail -n 15 "$f" 2>/dev/null || true
        done
        echo "--- Xorg log (last 30) ---"
        tail -n 30 /var/log/winduxedu-elevende-xorg.log 2>/dev/null || true
        echo "--- end display service failure evidence ---"
    } >>"$SERIAL" 2>&1 || true
}

if [ -d /run/live ]; then
    /usr/local/sbin/winduxedu-live-session-init
fi
USER_NAME="$(sed -n '1p' /etc/winduxedu/session-user 2>/dev/null || true)"
[ -n "$USER_NAME" ] || USER_NAME=user
id "$USER_NAME" >/dev/null 2>&1 || {
    echo "WinduxEdu ElevenDE session user does not exist: $USER_NAME" >&2
    exit 1
}
HOME_DIR="$(getent passwd "$USER_NAME" | awk -F: '{print $6}')"
[ -n "$HOME_DIR" ] && [ -d "$HOME_DIR" ] || {
    echo "WinduxEdu ElevenDE session home is not available for $USER_NAME" >&2
    exit 1
}

# Avoid a root desktop: create one temporary server cookie owned by the actual
# user, start the server from the service-held VT, then run ElevenDE as that
# user.  This is the same privilege split a display manager normally provides,
# without retaining an external greeter or LightDM dependency.
AUTH_FILE="$HOME_DIR/.Xauthority-winduxedu"
X_SOCKET=/tmp/.X11-unix/X0
X_LOCK=/tmp/.X0-lock
# xauth needs to create temporary lock files alongside the authority database,
# so the database must live in the unprivileged user's writable home directory,
# not in root-owned /run.
rm -f "$AUTH_FILE" "$AUTH_FILE-c" "$AUTH_FILE-l" "$X_SOCKET"
# An X server that died without unwinding (segfault, lost VT, panic) leaves its
# display lock behind, and LockServer() only reclaims that lock when the pid
# inside it is gone -- a recycled pid reads as "another server is already
# active for display 0" and every later launch exits within milliseconds.  This
# launcher is the only thing that starts display :0 on this image, so clearing
# a lock no live server owns cannot steal anybody's display; not clearing it
# turned one session crash into an unrecoverable Xorg restart loop.
if [ -e "$X_LOCK" ] && [ -d /tmp/.X11-unix ]; then
    # LockServer() pads the pid field, so keep the digits and drop the rest.
    lock_pid="$(sed -n '1p' "$X_LOCK" 2>/dev/null | tr -cd '0-9' || true)"
    lock_owner=""
    if [ -n "$lock_pid" ] && [ -r "/proc/$lock_pid/comm" ]; then
        lock_owner="$(sed -n '1p' "/proc/$lock_pid/comm" 2>/dev/null || true)"
    fi
    # Keep the lock only when it is genuinely owned by a running X server; a
    # dead pid, an empty file or a pid the kernel has since handed to some
    # unrelated process all mean "no server owns display :0".
    case "$lock_owner" in
    Xorg|xorg|Xorg.wrap) ;;
    *)
        rm -f "$X_LOCK"
        ser "stale xorg lock removed (owner=${lock_owner:-<no live owner>} pid=${lock_pid:-?})"
        ;;
    esac
fi
install -o "$USER_NAME" -g "$(id -gn "$USER_NAME")" -m 0600 /dev/null "$AUTH_FILE"
COOKIE="$(mcookie)"
runuser -u "$USER_NAME" -- xauth -f "$AUTH_FILE" add :0 . "$COOKIE"

/usr/lib/xorg/Xorg :0 vt7 -nolisten tcp -keeptty -auth "$AUTH_FILE" \
    >>/var/log/winduxedu-elevende-xorg.log 2>&1 &
X_PID=$!
ser "xorg-forked pid=$X_PID vt7"
cleanup() {
    kill "$X_PID" 2>/dev/null || true
    wait "$X_PID" 2>/dev/null || true
    rm -f "$AUTH_FILE" "$AUTH_FILE-c" "$AUTH_FILE-l"
}
trap cleanup EXIT INT TERM

ready=0
for attempt in $(seq 1 100); do
    if [ -S "$X_SOCKET" ]; then
        ready=1
        break
    fi
    if ! kill -0 "$X_PID" 2>/dev/null; then
        xrc=0
        wait "$X_PID" || xrc=$?
        ser "xorg-exited-before-display-ready rc=$xrc"
        echo "WinduxEdu Xorg exited before display :0 was ready; see /var/log/winduxedu-elevende-xorg.log" >&2
        # The exit status alone says nothing about *why* the server refused
        # display :0 (stale lock, VT held, driver fault); the last lines of its
        # own log do, and this is the only moment they still exist intact.
        dump_failure_evidence
        exit 1
    fi
    sleep 0.1
done
[ "$ready" = 1 ] || {
    ser "xorg-did-not-expose-display"
    echo "WinduxEdu Xorg did not expose display :0" >&2
    exit 1
}
ser "xorg-ready pid=$X_PID"

# Xorg owns VT7, but a system service does not automatically make that VT
# active. Record every request in the journal: Live console initialization can
# briefly select another VT after Xorg first becomes ready.
activate_x_vt() {
    local phase="$1" before after result
    before="$(cat /sys/class/tty/tty0/active 2>/dev/null || printf 'unknown')"
    if /usr/bin/chvt 7; then
        result=ok
    else
        result=failed
    fi
    after="$(cat /sys/class/tty/tty0/active 2>/dev/null || printf 'unknown')"
    logger -t winduxedu-elevende-display "VT7 activation ${phase}: ${before} -> ${after} (${result})"
    # The journal copy above is invisible to CI; the serial copy is what proves
    # or disproves the "VT never switched to tty7" theory for a black frame.
    ser "vt-activation ${phase}: ${before} -> ${after} (${result})"
}

if command -v chvt >/dev/null 2>&1; then
    activate_x_vt xorg-ready
fi

LIVE_FLAG=0
[ -d /run/live ] && LIVE_FLAG=1
LOGOUT_MARKER="$HOME_DIR/.cache/winduxedu-elevende-logout"
mkdir -p "$HOME_DIR/.cache"
chown "$USER_NAME:$(id -gn "$USER_NAME")" "$HOME_DIR/.cache"

start_elevende_session() {
    rm -f "$LOGOUT_MARKER"
    runuser -u "$USER_NAME" -- env \
        HOME="$HOME_DIR" USER="$USER_NAME" LOGNAME="$USER_NAME" \
        DISPLAY=:0 XAUTHORITY="$AUTH_FILE" \
        XDG_VTNR=7 XDG_SEAT=seat0 XDG_SESSION_TYPE=x11 \
        XDG_CURRENT_DESKTOP=ElevenDE XDG_SESSION_DESKTOP=ElevenDE \
        WINDUXEDU_LIVE_SESSION="$LIVE_FLAG" \
        /usr/local/bin/elevende-session &
    SESSION_PID=$!
}

start_elevende_session
ser "session-started pid=$SESSION_PID"

# Hand the journal-only guest state to a probe so the CI log alone can
# distinguish "the shell never painted" from "the VT was never selected".  It
# has to run in its own transient unit: a child of this service is killed with
# the service's cgroup the moment the service stops, and the very failure it is
# meant to document also stops the service -- the probe then never reaches its
# first probe point and the serial console keeps nothing but the failure.
if [ -x /usr/local/sbin/winduxedu-smoke-diagnostics ]; then
    if command -v systemd-run >/dev/null 2>&1; then
        systemd-run --unit=winduxedu-smoke-probe --collect --no-block \
            /usr/local/sbin/winduxedu-smoke-diagnostics >/dev/null 2>&1 || \
            /usr/local/sbin/winduxedu-smoke-diagnostics >/dev/null 2>&1 &
    else
        /usr/local/sbin/winduxedu-smoke-diagnostics >/dev/null 2>&1 &
    fi
    ser "smoke-diagnostics-started"
fi

# Virtual-console initialization can still activate a text VT after Xorg first
# becomes ready. Re-assert the graphical VT through the
# complete bounded startup burst. This remains a root display-service action,
# never an ElevenDE or Live-user privilege.
if command -v chvt >/dev/null 2>&1; then
    sleep 1
    activate_x_vt session-started
    sleep 3
    activate_x_vt session-initialized
    sleep 8
    activate_x_vt console-settled
    sleep 15
    activate_x_vt desktop-stable
fi

# An unexpected session exit used to end this service, which tore the healthy
# Xorg down with it; every restart then had to reclaim display :0 on VT7 and
# the guest spent the rest of the smoke window in a three-second Xorg failure
# loop with the desktop never repainted.  The server that is already up is the
# expensive part, so keep it and respawn the session instead -- capped, so a
# genuinely broken shell cannot spin here either.
SESSION_TRY=0
SESSION_TRY_MAX=3

stop_session_leftovers() {
    # An unmarked exit skips the session script's own cleanup: its shell,
    # compositor, window manager, widgets and the WinduxEdu helpers keep the X
    # connection and the desktop they painted.  A second session on top of
    # those would draw a second taskbar over the first.  Matched on the helper
    # name rather than one path prefix so the component launcher's children
    # (winduxedu-widgets, ...) are covered too; restricted to the session user,
    # which is what keeps the display service itself and the root-owned smoke
    # probe out of reach.
    pkill -u "$USER_NAME" -f 'winduxedu-' 2>/dev/null || true
    for s in elevende-shell picom openbox elevende-notifyd sas-screen \
             lxqt-policykit-agent; do
        pkill -u "$USER_NAME" -x "$s" 2>/dev/null || true
    done
    sleep 1
}

while :; do
    session_rc=0
    # `wait` returns the child's status, and this script runs under `set -e`:
    # the bare `wait $PID; session_rc=$?` form exited the service before the
    # status was ever recorded, so an unexpected session death produced no
    # marker, no log line and no evidence at all.
    wait "$SESSION_PID" || session_rc=$?
    exit_marker=unmarked
    if [ -f "$LOGOUT_MARKER" ]; then
        exit_marker=explicit
    fi
    ser "session-exit rc=$session_rc marker=$exit_marker"
    if [ -f "$LOGOUT_MARKER" ]; then
        # Only winduxedu-logout creates this marker.  Keep Xorg and its VT alive,
        # then launch a fresh native login session; resolution changes and
        # crashes never enter this branch.
        rm -f "$LOGOUT_MARKER"
        logger -t winduxedu-elevende-display "explicit logout; restarting native ElevenDE session"
        sleep 1
        start_elevende_session
        ser "session-restarted pid=$SESSION_PID"
        continue
    fi
    logger -t winduxedu-elevende-display "unexpected ElevenDE session exit (${session_rc})"
    # A dead Xorg makes Openbox exit, and a dead session makes this launcher
    # kill Xorg -- from the outside the two are the same event, and they are
    # fixed differently.  Ask the server itself: it is still a child here, so
    # its status is reaped now and tells which side went first.
    if kill -0 "$X_PID" 2>/dev/null; then
        ser "x-status alive session-rc=$session_rc"
    else
        xrc=0
        wait "$X_PID" || xrc=$?
        ser "x-status dead rc=$xrc session-rc=$session_rc"
    fi
    # Restart=on-failure ignores a zero exit.  An unmarked session ending is
    # never a clean display-service shutdown, so normalize it to failure.
    [ "$session_rc" -ne 0 ] || session_rc=1
    dump_failure_evidence
    SESSION_TRY=$((SESSION_TRY + 1))
    if [ "$SESSION_TRY" -gt "$SESSION_TRY_MAX" ]; then
        ser "session-gives-up rc=$session_rc after $SESSION_TRY respawns"
        exit "$session_rc"
    fi
    ser "session-respawn=$SESSION_TRY/$SESSION_TRY_MAX rc=$session_rc"
    stop_session_leftovers
    start_elevende_session
    ser "session-restarted pid=$SESSION_PID"
done
