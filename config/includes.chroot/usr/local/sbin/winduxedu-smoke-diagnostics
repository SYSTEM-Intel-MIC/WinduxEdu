#!/bin/sh
# Mirror the guest state a CI smoke run needs onto the serial console.
#
# Everything that explains a black captured frame -- the Xorg log, the journal
# of the display/session units, the active VT, the X window tree, OOM and
# segfault reports -- only ever reaches the journal.  The QEMU smoke test wires
# the serial port to a plain file, so without this probe those stay invisible
# and a black frame cannot be root-caused from CI logs alone.
#
# Probed twice (60 s and a further 240 s later) so the output brackets both
# "never rendered" and "rendered, then lost".  Gated on console=ttyS0: the Live
# image always boots with it (see --bootappend-live), an installed system does
# not, so this is inert outside the smoke run.

[ -r /proc/cmdline ] || exit 0
grep -qw 'console=ttyS0' /proc/cmdline || exit 0
SERIAL=/dev/ttyS0
[ -w "$SERIAL" ] || exit 0

window_tree() {
    command -v xwininfo >/dev/null 2>&1 || {
        echo 'xwininfo unavailable'
        return 0
    }
    session_user="$(sed -n '1p' /etc/winduxedu/session-user 2>/dev/null || true)"
    [ -n "$session_user" ] || session_user=user
    auth_file="$(ls -1t /home/*/.Xauthority-winduxedu 2>/dev/null | head -n 1 || true)"
    if [ -z "$auth_file" ]; then
        echo 'no X authority file is present yet'
        return 0
    fi
    runuser -u "$session_user" -- env DISPLAY=:0 XAUTHORITY="$auth_file" \
        xwininfo -root -tree 2>&1 | head -n 45 || true
}

probe() {
    {
        printf '\n===== WINDUXEDU SMOKE DIAGNOSTICS %s =====\n' \
            "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo unknown)"
        printf 'uptime seconds: %s\n' \
            "$(cut -d' ' -f1 /proc/uptime 2>/dev/null || echo unknown)"

        printf '%s\n' '-- active vt --'
        cat /sys/class/tty/tty0/active 2>/dev/null || echo 'unavailable'

        printf '%s\n' '-- failed units --'
        systemctl --failed --no-pager --full 2>/dev/null || echo 'systemctl unavailable'

        printf '%s\n' '-- display/session unit states --'
        systemctl is-active winduxedu-elevende-display \
            winduxedu-live-session-init 2>/dev/null || true

        printf '%s\n' '-- display/session journal --'
        journalctl -b -u winduxedu-elevende-display \
            -u winduxedu-live-session-init --no-pager -n 50 2>/dev/null || true

        printf '%s\n' '-- system journal errors --'
        journalctl -b -p err --no-pager -n 40 2>/dev/null || true

        printf '%s\n' '-- kernel oom/segfault --'
        dmesg 2>/dev/null | grep -iE 'oom-kill|out of memory|segfault|killed process' \
            | tail -n 20 || true

        printf '%s\n' '-- memory --'
        free -m 2>/dev/null || head -n 5 /proc/meminfo 2>/dev/null || true

        printf '%s\n' '-- xorg log tail --'
        tail -n 45 /var/log/winduxedu-elevende-xorg.log 2>/dev/null \
            || echo 'no Xorg log is present'

        # Without a device list a black frame cannot be told apart from a
        # desktop whose touch node the X server never added -- the input path
        # a field report of "touch is dead" would have to be judged from.
        printf '%s\n' '-- input devices --'
        xinput --list 2>&1 || echo 'xinput unavailable'
        printf '%s\n' '-- kernel input devices --'
        grep -E '^(I:|N: |H: |B: PROP|B: ABS)' /proc/bus/input/devices 2>/dev/null \
            || echo 'no /proc/bus/input/devices'
        printf '%s\n' '-- /dev/input --'
        ls -l /dev/input 2>/dev/null || echo '/dev/input is missing'
        # The single decisive field: a touch node without ID_INPUT is never
        # added by X, and one with only ID_INPUT_MOUSE is refused by libinput.
        printf '%s\n' '-- udev input tags --'
        for node in /dev/input/event*; do
            [ -e "$node" ] || continue
            printf '%s: ' "$node"
            udevadm info --query=property --name="$node" 2>/dev/null \
                | sed -n 's/^\(ID_INPUT[A-Z_]*\)=.*/\1/p' | tr '\n' ' ' \
                || true
            printf ' (%s)\n' "$(udevadm info --query=name --name="$node" 2>/dev/null || echo unknown)"
        done
        printf '%s\n' '-- touchscreen helper log --'
        tail -n 25 /tmp/winduxedu-winduxedu-touch-fix.log 2>/dev/null \
            || echo 'winduxedu-touch-fix has not logged yet'

        printf '%s\n' '-- x window tree --'
        window_tree

        printf '%s\n' '-- largest processes --'
        ps -eo pid,ppid,rss,stat,comm --sort=-rss 2>/dev/null | head -n 20 || true

        printf '%s\n' '-- desktop processes --'
        ps -eo pid,stat,rss,args 2>/dev/null \
            | grep -E 'elevende|/usr/lib/xorg/Xorg|winduxedu' | grep -v grep || true

        printf '===== END WINDUXEDU SMOKE DIAGNOSTICS =====\n'
    } >>"$SERIAL" 2>&1 || true
}

sleep "${WINDUXEDU_DIAG_FIRST_DELAY:-60}"
probe
sleep "${WINDUXEDU_DIAG_SECOND_DELAY:-240}"
probe
exit 0
