# WinduxEdu 硬件兼容性层（最大兼容）
# 策略与来源：docs/HARDWARE-COMPATIBILITY.md。
# 全部包名已对照 Debian Bookworm 归档（main + non-free-firmware）逐一验证；
# 仅存在于 bookworm-backports 的固件（firmware-intel-graphics、
# firmware-intel-misc、firmware-mediatek、firmware-cirrus、
# firmware-marvell-prestera）不进入镜像，作为可选项见兼容性文档。
# 与 winduxedu-desktop.list.chroot 重复的固件不在此重复。

# DKMS 基础环境（out-of-tree 驱动前置依赖）
dkms
build-essential
# Kernel headers for DKMS builds (matches linux-image-amd64)
linux-headers-amd64

# CPU 微码
intel-microcode
amd64-microcode

# 固件：non-free-firmware 全量覆盖（Bookworm 实际存在的子集）
firmware-linux-nonfree
firmware-libertas
firmware-ti-connectivity
firmware-sof-signed
firmware-samsung
firmware-qlogic
firmware-cavium
firmware-bnx2
firmware-bnx2x
firmware-myricom
firmware-netxen

# 显卡开源栈工具（Intel/AMD 内核 modesetting + Mesa）
mesa-utils
mesa-va-drivers
intel-media-va-driver

# 网卡：cfg80211 依赖 regulatory.db 才能注册射频规则，缺失时无线网卡会
# 注册成功却始终扫描不到任何热点；ethtool/iw 用于现场诊断有线协商与无线链路。
wireless-regdb
iw
ethtool

# 蓝牙
bluez
bluez-tools
libspa-0.2-bluetooth

# 音频：PipeWire（Debian 默认音频栈）
pipewire
pipewire-pulse
# 原生 ALSA 应用（希沃白板、钉钉、ONLYOFFICE 等）不经过 PulseAudio 协议，
# 由 pipewire-alsa 提供 ALSA 插件接入同一音频栈，避免第二个声音服务。
pipewire-alsa
wireplumber
# UCM 配置（alsa-utils 不依赖它）：一体机板载声卡与 USB 音频的通道路由。
alsa-ucm-conf

# 输入：libinput 统一键盘/鼠标/触摸屏
xserver-xorg-input-libinput
libinput-tools
evtest
xinput-calibrator
# xinput 是会话内触屏修复/校准的实际执行工具（启用设备、重置坐标变换矩阵、
# 映射到输出）。xinput-calibrator 只提供图形向导，本身不写入运行时属性。
xinput

# 无障碍与屏幕键盘（教育版设置：屏幕键盘开关，登录界面同样生效）
# matchbox-keyboard 见 winduxedu-education.list.chroot；此处提供其判定输入焦点
# 所依赖的 AT-SPI2 运行时（Debian 包 at-spi2-core + python3-pyatspi）。
at-spi2-core
python3-pyatspi

# 摄像头（UVC）
v4l-utils
guvcview
ffmpeg

# 打印与扫描
cups
cups-filters
cups-client
cups-daemon
printer-driver-all
openprinting-ppds
foomatic-db-compressed-ppds
hplip
libsane-hpaio
sane-utils

# 指纹识别框架
fprintd
libpam-fprintd

# Wine 11 支持（运行 Windows 生产力应用，如 Office、钉钉等）
# 启用 32 位架构，Wine WoW64 依赖 i386 库
# 核心 Wine 包
wine
wine32
wine64
libwine
libwine:i386
fonts-wine

# Wine 依赖的 32 位库（i386 架构）
libasound2:i386
libasound2-plugins:i386
libgstreamer-plugins-base1.0-0:i386
